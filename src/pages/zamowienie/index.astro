    }
    .ramka-chip:hover { border-color: var(--color-accent); color: var(--color-accent); }
    .ramka-chip.is-selected { background-color: var(--color-accent); color: #fff; border-color: var(--color-accent); }

    .filter-chip {
      padding: 0.4rem 0.9rem; border-radius: 9999px;
