          <form id="contact-form" class="mt-8 max-w-2xl mx-auto card-base rounded-3xl p-6 md:p-8 grid sm:grid-cols-2 gap-5" novalidate>
            <div class="sm:col-span-2">
              <label class="form-label" for="f-name">Imię i nazwisko *</label>
