    .dark .producer-logo { filter: brightness(0) invert(1); opacity: 0.9; }

    .catalog-logo {
      width: 74px; height: auto; max-height: 18px; object-fit: contain;
      filter: brightness(0); opacity: 0.75; vertical-align: middle;
