---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { PRODUCENCI, ZESTAWY_PROBEK, PRICING, RODZINY, KATALOG_UPDATED } from '../../data/zamowienie';

// Strona robocza kreatora zamówień — na razie bez linku w nawigacji i noindex.
// Katalog (499 dekorów) renderujemy po stronie klienta z tego JSON-a — wersja
// serwerowa dawałaby setki kilobajtów HTML-a, z czego widać jednorazowo garść.
const clientData = {
  producenci: PRODUCENCI.map(({ id, name, logo, sheetFormat, sheetAreaM2, arkusze }) => ({
    id, name, logo, sheetFormat, sheetAreaM2,
    arkusze: arkusze.map((a) => ({
      c: a.code, n: a.name, s: a.finish, pr: a.price, a: a.area, fm: a.format, f: a.family, i: a.img,
    })),
  })),
  pricing: PRICING,
  rodziny: RODZINY,
  zestawy: ZESTAWY_PROBEK.map(({ id, name, price }) => ({ id, name, price })),
  apiBase: 'https://iedy003jrg.execute-api.eu-central-1.amazonaws.com',
};
---

<BaseLayout
  title="Zamówienie online"
  description="Zamów próbki lub fronty ramiakowe na wymiar — skonfiguruj zamówienie online i poznaj wycenę od ręki."
  noindex={true}
>
  <Navbar />

  <main class="pt-20 md:pt-24" style="background-color: var(--color-bg);">
    <!-- Wizard -->
    <section class="section-padding pt-6 md:pt-8 pb-24 md:pb-32">
      <div class="max-w-5xl mx-auto">

        <!-- Kompaktowa belka: tytuł + reset -->
        <div class="mb-6 md:mb-8 flex items-center justify-between gap-4 flex-wrap">
          <h1 class="font-display text-xl sm:text-2xl tracking-tight" style="color: var(--color-text);">
            Zamówienie <span class="text-gradient">online</span>
          </h1>
          <button type="button" id="btn-reset" class="inline-flex items-center gap-1.5 text-xs font-heading font-medium transition-colors hover:opacity-80" style="color: var(--color-text-muted);" title="Wyczyść formularz i zacznij od początku" hidden>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
            Zacznij od nowa
          </button>
        </div>

        <!-- Progress -->
        <nav id="wizard-progress" class="mb-8 md:mb-10 flex items-center justify-center gap-1.5 sm:gap-2 flex-wrap" aria-label="Postęp zamówienia"></nav>

        <!-- ====================================================== STEP: TYP -->
        <section data-step="type" class="wizard-step">
          <h2 class="font-display text-2xl sm:text-3xl tracking-tight text-center" style="color: var(--color-text);">Co chcesz zamówić?</h2>
          <p class="mt-3 text-sm md:text-base font-body text-center" style="color: var(--color-text-secondary);">Wybierz jedną z opcji, aby przejść dalej.</p>

          <div class="mt-8 grid sm:grid-cols-2 gap-5 md:gap-6">
            <button type="button" class="choice-card card-base rounded-3xl p-7 md:p-9 text-left" data-choose-type="samples">
              <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-5" style="background-color: var(--color-bg-tertiary); color: var(--color-accent);">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 7.125C2.25 6.504 2.754 6 3.375 6h6c.621 0 1.125.504 1.125 1.125v3.75c0 .621-.504 1.125-1.125 1.125h-6a1.125 1.125 0 01-1.125-1.125v-3.75zM14.25 8.625c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v8.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 01-1.125-1.125v-8.25zM3.75 16.125c0-.621.504-1.125 1.125-1.125h5.25c.621 0 1.125.504 1.125 1.125v2.25c0 .621-.504 1.125-1.125 1.125h-5.25a1.125 1.125 0 01-1.125-1.125v-2.25z" />
                </svg>
              </div>
              <h3 class="font-heading text-xl font-semibold" style="color: var(--color-text);">Zamów próbki</h3>
              <p class="mt-2 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">
                Gotowe zestawy próbek przygotowane przez Mekra — zobacz i dotknij jakości
                naszych frontów, zanim zamówisz na wymiar.
              </p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-heading font-semibold" style="color: var(--color-accent);">
                Wybieram próbki
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </span>
            </button>

            <button type="button" class="choice-card card-base rounded-3xl p-7 md:p-9 text-left" data-choose-type="custom">
              <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-5" style="background-color: var(--color-bg-tertiary); color: var(--color-accent);">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
                </svg>
              </div>
              <h3 class="font-heading text-xl font-semibold" style="color: var(--color-text);">Zamówienie na wymiar</h3>
              <p class="mt-2 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">
                Fronty ramiakowe z wybranej przez Ciebie płyty. Wskaż producenta, dekor
                i metraż — cena wyliczy się automatycznie.
              </p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-heading font-semibold" style="color: var(--color-accent);">
                Konfiguruję fronty
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </span>
            </button>
          </div>
        </section>

        <!-- =================================================== STEP: PRÓBKI -->
        <section data-step="samples" class="wizard-step" hidden>
          <h2 class="font-display text-2xl sm:text-3xl tracking-tight text-center" style="color: var(--color-text);">Wybierz zestaw próbek</h2>
          <p class="mt-3 text-sm md:text-base font-body text-center max-w-2xl mx-auto" style="color: var(--color-text-secondary);">
            Próbki przygotowujemy sami — nie musisz wybierać materiału ani producenta.
            Koszt i wysyłkę potwierdzimy przy realizacji.
          </p>

          <div class="mt-8 grid sm:grid-cols-2 gap-5 max-w-3xl mx-auto">
            {ZESTAWY_PROBEK.map((z) => (
              <button type="button" class="choice-card card-base rounded-2xl p-6 md:p-7 text-left" data-choose-sample={z.id}>
                <h3 class="font-heading text-lg font-semibold" style="color: var(--color-text);">{z.name}</h3>
                <p class="mt-2 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">{z.text}</p>
                <div class="mt-5 pt-4 flex items-baseline gap-2" style="border-top: 1px solid var(--color-border);">
                  {z.price !== null ? (
                    <>
                      <span class="font-display text-2xl" style="color: var(--color-accent);">{z.price} zł</span>
                      <span class="text-xs font-heading font-medium tracking-wider uppercase" style="color: var(--color-text-muted);">netto</span>
                    </>
                  ) : (
                    <span class="text-xs font-heading font-medium tracking-wider uppercase" style="color: var(--color-text-muted);">Koszt potwierdzimy przy realizacji</span>
                  )}
                </div>
              </button>
            ))}
          </div>
        </section>

        <!-- ================================================ STEP: PRODUCENT -->
        <section data-step="producer" class="wizard-step" hidden>
          <h2 class="font-display text-2xl sm:text-3xl tracking-tight text-center" style="color: var(--color-text);">Wybierz producenta płyty</h2>
          <p class="mt-3 text-sm md:text-base font-body text-center max-w-2xl mx-auto" style="color: var(--color-text-secondary);">
            Pracujemy na płytach sprawdzonych producentów. Cena frontu zależy od wybranego
            arkusza — w następnym kroku zobaczysz katalog dekorów.
          </p>

          <div class="mt-8 grid sm:grid-cols-2 gap-5">
            {PRODUCENCI.map((p) => (
              <button type="button" class="choice-card card-base rounded-2xl p-6 md:p-7 text-left" data-choose-producer={p.id}>
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <img src={p.logo} alt={`Logo ${p.name}`} width="130" height="26" loading="lazy" decoding="async" class="producer-logo" />
                    <p class="mt-3 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">{p.tagline}</p>
                  </div>
                  <span class="label-tag whitespace-nowrap">{p.arkusze.length} dekorów</span>
                </div>
                <p class="mt-4 text-sm font-heading font-semibold" style="color: var(--color-accent);">
                  Płyta od {Math.round(Math.min(...p.arkusze.map((a) => a.price / a.area)))} zł/m²
                  <span class="font-medium" style="color: var(--color-text-muted);">
                    do {Math.round(Math.max(...p.arkusze.map((a) => a.price / a.area)))} zł/m² netto
                  </span>
                </p>
                <p class="mt-1 text-xs font-heading font-medium tracking-wider uppercase" style="color: var(--color-text-muted);">
                  Arkusz {p.sheetFormat} mm
                </p>
              </button>
            ))}
          </div>
        </section>

        <!-- ================================================== STEP: KATALOG -->
        <section data-step="catalog" class="wizard-step" hidden>
          <div class="text-center">
            <span class="label-tag inline-flex items-center gap-2">
              Katalog:
              <img id="catalog-producer-logo" src="" alt="" class="catalog-logo" hidden />
              <span id="catalog-producer-name" class="normal-case sr-only"></span>
            </span>
            <h2 class="mt-5 font-display text-2xl sm:text-3xl tracking-tight" style="color: var(--color-text);">Wybierz dekor arkusza</h2>
            <p class="mt-3 text-sm md:text-base font-body max-w-2xl mx-auto" style="color: var(--color-text-secondary);">
              Cena arkusza wliczana jest do wyceny. Nie znalazłeś swojego dekoru?
              Wykonamy fronty z każdej płyty dostępnej na rynku — napisz nam, czego szukasz.
            </p>
          </div>

          <div class="mt-8 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
            <div class="relative flex-1 max-w-sm">
              <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
              <input id="catalog-search" type="search" placeholder="Szukaj dekoru lub kodu…"
                class="w-full pl-10 pr-4 py-2.5 rounded-xl text-sm font-body outline-none transition-colors"
                style="background-color: var(--color-card-bg); border: 1.5px solid var(--color-border); color: var(--color-text);" />
            </div>
            <div class="flex gap-2 flex-wrap items-center">
              <div id="catalog-filters" class="flex gap-2 flex-wrap"></div>
              <select id="catalog-sort" aria-label="Sortowanie dekorów"
                class="px-3 py-2 rounded-xl text-xs font-heading font-semibold outline-none cursor-pointer"
                style="background-color: var(--color-card-bg); border: 1.5px solid var(--color-border); color: var(--color-text);">
                <option value="price-asc">Cena: od najtańszych</option>
                <option value="price-desc">Cena: od najdroższych</option>
                <option value="name">Nazwa A–Z</option>
              </select>
            </div>
          </div>

          <div id="catalog-grid" class="mt-6 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>

          <div class="mt-8 text-center">
            <button type="button" id="catalog-more" class="btn-secondary" hidden>Pokaż kolejne dekory</button>
            <p id="catalog-count" class="mt-4 text-xs font-body" style="color: var(--color-text-muted);"></p>
          </div>

          <p id="catalog-empty" class="mt-10 text-center text-sm font-body" style="color: var(--color-text-muted);" hidden>
            Brak dekorów pasujących do wyszukiwania.
          </p>
        </section>

        <!-- ================================================== STEP: METRAŻ -->
        <section data-step="details" class="wizard-step" hidden>
          <div class="grid lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-8 lg:gap-10 items-start">
            <div class="space-y-6">
              <div>
                <h2 class="font-display text-2xl sm:text-3xl tracking-tight" style="color: var(--color-text);">Formatki i opcje</h2>
                <p class="mt-2 text-sm md:text-base font-body" style="color: var(--color-text-secondary);">
                  Podaj wymiary frontów — powierzchnia i wycena liczą się na bieżąco.
                </p>
              </div>

              <!-- Pozycje zamówienia (dekory) -->
              <div class="card-base rounded-2xl p-5">
                <div class="flex items-center justify-between gap-3">
                  <p class="text-xs font-heading font-medium tracking-wider uppercase" style="color: var(--color-text-muted);">Dekory w zamówieniu</p>
                  <button type="button" id="btn-add-position" class="inline-flex items-center gap-1.5 text-sm font-heading font-semibold transition-colors hover:opacity-80" style="color: var(--color-accent);">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                    Dodaj kolejny dekor
                  </button>
                </div>
                <div id="positions-list" class="mt-3 space-y-2"></div>
                <p class="mt-3 text-2xs font-body" style="color: var(--color-text-muted);">
                  Formatki i grubość ramki poniżej dotyczą podświetlonego dekoru — kliknij pozycję, aby ją edytować.
                  Wykonanie (150 zł/m²) i minimum logistyczne liczymy od sumy całego zamówienia.
                </p>
              </div>

              <!-- Formatki + powierzchnia -->
              <div class="card-base rounded-2xl p-6">
                <p class="font-heading text-base font-semibold" style="color: var(--color-text);">Formatki frontów</p>
                <p class="mt-1 text-xs font-body" style="color: var(--color-text-secondary);">
                  Wymiary w milimetrach. Powierzchnię wyliczamy automatycznie z listy formatek.
                </p>

                <div id="formatki-head" class="mt-4 grid grid-cols-[1fr_1fr_4rem_4rem_1.75rem] gap-2 px-0.5 text-2xs font-heading font-medium uppercase tracking-wider" style="color: var(--color-text-muted);">
                  <span>Szerokość [mm]</span><span>Wysokość [mm]</span><span>Ilość</span><span class="text-right">m²</span><span></span>
                </div>
                <div id="formatki-rows" class="mt-1.5 space-y-2"></div>
                <button type="button" id="btn-add-row" class="mt-3 inline-flex items-center gap-1.5 text-sm font-heading font-semibold transition-colors hover:opacity-80" style="color: var(--color-accent);">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                  Dodaj formatkę
                </button>

                <p id="hardware-note" class="mt-3 text-xs font-body px-3 py-2 rounded-lg" style="background-color: var(--color-bg-tertiary); color: var(--color-accent);" hidden>
                  Fronty powyżej 800 mm wysokości lub 600 mm szerokości wymagają okuć napinających albo zwiększonej liczby zawiasów — uwzględnimy to przy potwierdzeniu specyfikacji.
                </p>

                <label class="mt-4 flex items-start gap-2.5 cursor-pointer text-sm font-body" style="color: var(--color-text-secondary);">
                  <input type="checkbox" id="m2-manual-toggle" class="mt-0.5 w-4 h-4 rounded accent-[#866751] flex-shrink-0" />
                  <span>Nie znam jeszcze dokładnych wymiarów — podam samą powierzchnię, a formatki doślę po zamówieniu.</span>
                </label>

                <div id="manual-m2-box" class="mt-4 flex items-center gap-3" hidden>
                  <button type="button" class="m2-btn" data-m2-delta="-1" aria-label="Zmniejsz o 1 m²">−</button>
                  <div class="relative">
                    <input id="input-m2" type="number" min="0.5" step="0.5" value="5" inputmode="decimal"
                      class="w-28 text-center py-2.5 rounded-xl text-lg font-heading font-semibold outline-none"
                      style="background-color: var(--color-bg-secondary); border: 1.5px solid var(--color-border); color: var(--color-text);" />
                    <span class="absolute -bottom-5 left-0 right-0 text-center text-2xs font-heading uppercase tracking-widest" style="color: var(--color-text-muted);">m²</span>
                  </div>
                  <button type="button" class="m2-btn" data-m2-delta="1" aria-label="Zwiększ o 1 m²">+</button>
                </div>

                <div class="mt-5 pt-4 flex items-baseline justify-between" style="border-top: 1px solid var(--color-border);">
                  <span class="font-heading text-sm font-semibold uppercase tracking-wider" style="color: var(--color-text);">Powierzchnia frontów</span>
                  <span id="m2-display" class="font-display text-2xl" style="color: var(--color-accent);">0 m²</span>
                </div>
                <p class="mt-1 text-xs font-body" style="color: var(--color-text-muted);">
                  Minimum logistyczne to {PRICING.minM2} m² — poniżej doliczamy +{PRICING.belowMinPct}% wartości zamówienia.
                </p>
                <p id="min-warning" class="mt-3 text-xs font-body px-3 py-2 rounded-lg" style="background-color: var(--color-bg-tertiary); color: var(--color-accent);" hidden>
                  Zamówienie poniżej {PRICING.minM2} m² — doliczona zostanie dopłata +{PRICING.belowMinPct}% wartości zamówienia netto.
                </p>
                <p id="m2-error" class="mt-3 text-xs font-body" style="color: #b4443c;" hidden>
                  Każdy dekor w zamówieniu musi mieć wybrany materiał i formatki (albo podaną powierzchnię).
                  Uzupełnij lub usuń niekompletne pozycje, żeby przejść dalej.
                </p>
              </div>

              <!-- Ramka -->
              <div class="card-base rounded-2xl p-6">
                <p class="font-heading text-base font-semibold" style="color: var(--color-text);">Grubość ramki</p>
                <div class="mt-3 flex flex-wrap gap-2" id="ramka-options">
                  {PRICING.ramki.map((r, i) => (
                    <button type="button" class={`ramka-chip${i === 1 ? ' is-selected' : ''}`} data-ramka={r}>{r}</button>
                  ))}
                </div>
              </div>

              <!-- Dodatki -->
              <div class="card-base rounded-2xl p-6">
                <p class="font-heading text-base font-semibold" style="color: var(--color-text);">Opcje dodatkowe</p>
                <p class="mt-1 text-xs font-body" style="color: var(--color-text-secondary);">Zgodnie z cennikiem — podaj liczbę frontów dla wybranych opcji.</p>
                <div class="mt-4 space-y-3">
                  {PRICING.addons.map((a) => (
                    <div class="flex items-center justify-between gap-4 py-2" style="border-bottom: 1px solid var(--color-border);">
                      <div class="min-w-0">
                        <p class="font-heading text-sm font-semibold" style="color: var(--color-text);">{a.name}</p>
                        <p class="text-xs font-body" style="color: var(--color-text-muted);">+{a.price} {a.unit}</p>
                      </div>
                      <input type="number" min="0" step="1" value="0" inputmode="numeric" data-addon={a.id} data-addon-price={a.price}
                        class="w-16 text-center py-1.5 rounded-lg text-sm font-heading font-semibold outline-none flex-shrink-0"
                        style="background-color: var(--color-bg-secondary); border: 1.5px solid var(--color-border); color: var(--color-text);" />
                    </div>
                  ))}
                  <label class="flex items-center justify-between gap-4 py-2 cursor-pointer">
                    <div>
                      <p class="font-heading text-sm font-semibold" style="color: var(--color-text);">Słój przechodzący</p>
                      <p class="text-xs font-body" style="color: var(--color-text-muted);">Ciągłość usłojenia między frontami · +{PRICING.grainMatchPct}% wartości zamówienia netto</p>
                    </div>
                    <input id="input-grain" type="checkbox" class="w-5 h-5 rounded accent-[#866751] flex-shrink-0" />
                  </label>
                </div>
              </div>

            </div>

            <!-- Wycena live -->
            <aside class="lg:sticky lg:top-28">
              <div class="card-base rounded-3xl p-6 md:p-7">
                <span class="label-tag">Twoja wycena</span>
                <dl id="price-breakdown" class="mt-5 space-y-2.5 text-sm font-body"></dl>
                <div class="mt-5 pt-5 flex items-baseline justify-between" style="border-top: 1px solid var(--color-border);">
                  <dt class="font-heading text-sm font-semibold uppercase tracking-wider" style="color: var(--color-text);">Razem netto</dt>
