    .progress-dot.is-done .num { background-color: var(--color-accent); color: #fff; border-color: transparent; }
    .progress-sep { width: 1rem; height: 1px; background-color: var(--color-border); }

    .fmt-input {
      width: 100%; padding: 0.55rem 0.6rem; border-radius: 0.6rem;
