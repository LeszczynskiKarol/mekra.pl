    .form-input:focus { border-color: var(--color-accent); }
    .form-input.is-invalid { border-color: #b4443c; }

    #catalog-search:focus { border-color: var(--color-accent); }
  </style>

  <script>
    // ==================== Kreator zamówień — logika kliencka ====================
    const DATA = JSON.parse(document.getElementById('order-data')!.textContent!);
    const PRICING = DATA.pricing;

    type StepId = 'type' | 'samples' | 'producer' | 'catalog' | 'details' | 'contact' | 'summary';

    const FLOWS: Record<string, StepId[]> = {
      samples: ['type', 'samples', 'contact', 'summary'],
      custom: ['type', 'producer', 'catalog', 'details', 'contact', 'summary'],
    };
    const STEP_LABELS: Record<StepId, string> = {
      type: 'Typ', samples: 'Próbki', producer: 'Producent',
      catalog: 'Dekor', details: 'Wymiary', contact: 'Dane', summary: 'Podsumowanie',
    };

    type Formatka = { w: number; h: number; qty: number };
    type Producer = { id: string; name: string; logo: string; sheetFormat: string; sheetAreaM2: number };
    type Sheet = { code: string; name: string; finish: string; price: number; img: string; area: number; format?: string };
    // Pozycja zamówienia = jeden dekor + jego formatki. Zamówienie może mieć
    // wiele pozycji (różne dekory / producenci) — marża 150 zł/m², minimum 4 m²
    // i słój przechodzący liczą się od SUMY całego zamówienia.
    type Position = {
      producer: Producer | null;
      sheet: Sheet | null;
      ramka: string;
      formatki: Formatka[];
      m2Mode: 'formatki' | 'manual';
      m2: number;
    };
    const newPosition = (): Position => ({
      producer: null, sheet: null, ramka: '18 mm',
      formatki: [{ w: 0, h: 0, qty: 1 }], m2Mode: 'formatki', m2: 0,
    });
    const state = {
      type: null as null | 'samples' | 'custom',
      sampleSet: null as null | { id: string; name: string },
      positions: [newPosition()] as Position[],
      active: 0,
      addons: {} as Record<string, number>,
      grain: false,
      contact: {} as Record<string, string>,
    };
    const pos = () => state.positions[state.active];
    const donePositions = () => state.positions.filter((p) => p.sheet && p.m2 > 0);
    const totalM2 = () => Math.round(state.positions.reduce((s, p) => s + (p.sheet ? p.m2 : 0), 0) * 100) / 100;
    let currentStep: StepId = 'type';

    const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector(sel) as T;
    const $$ = <T extends HTMLElement = HTMLElement>(sel: string) => Array.from(document.querySelectorAll(sel)) as T[];

    // --------------------------------------------- persystencja (localStorage)
    const STORAGE_KEY = 'mekra-order-v2'; // v2: model pozycji (wiele dekorów w zamówieniu)

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ state, currentStep }));
      } catch { /* prywatny tryb / brak miejsca — trudno */ }
      updateResetVisibility();
    }

    function updateResetVisibility() {
      $('#btn-reset').hidden = state.type === null;
    }

    function restoreState() {
      let saved: any = null;
      try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); } catch { /* ignore */ }
      if (!saved || !saved.state || !saved.state.type) return;
      Object.assign(state, saved.state);

      // sanityzacja pozycji po odczycie
      if (!Array.isArray(state.positions) || !state.positions.length) state.positions = [newPosition()];
      state.positions.forEach((p) => {
        if (!Array.isArray(p.formatki) || !p.formatki.length) p.formatki = [{ w: 0, h: 0, qty: 1 }];
        if (p.m2Mode !== 'manual') p.m2Mode = 'formatki';
        if (!p.ramka) p.ramka = '18 mm';
      });
      if (typeof state.active !== 'number' || !state.positions[state.active]) state.active = 0;

      // odtworzenie zaznaczeń w UI
      $$('[data-choose-type]').forEach((b) => b.classList.toggle('is-selected', b.dataset.chooseType === state.type));
      if (state.sampleSet) $$('[data-choose-sample]').forEach((b) => b.classList.toggle('is-selected', b.dataset.chooseSample === state.sampleSet!.id));
      syncProducerSelection();
      for (const [id, qty] of Object.entries(state.addons)) {
        const el = document.querySelector(`[data-addon="${id}"]`) as HTMLInputElement | null;
        if (el) el.value = String(qty);
      }
      ($('#input-grain') as HTMLInputElement).checked = state.grain;
      const form = $('#contact-form') as HTMLFormElement;
      for (const f of CONTACT_FIELDS) {
        const el = form.elements.namedItem(f) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el && state.contact[f]) el.value = state.contact[f];
      }
      // zgody RODO celowo nie przywracamy — ma być zaznaczona świadomie

      const step = saved.currentStep as StepId | undefined;
      if (step && FLOWS[state.type!].includes(step)) goTo(step);
    }

    // Modal „Zacznij od nowa" — spójny ze stroną zamiast systemowego confirm().
    const resetModal = $('#reset-modal');
    const closeResetModal = () => { resetModal.hidden = true; };
    $('#btn-reset').addEventListener('click', () => {
      resetModal.hidden = false;
      ($('#reset-cancel') as HTMLButtonElement).focus();
    });
    $('#reset-cancel').addEventListener('click', closeResetModal);
    $('#reset-backdrop').addEventListener('click', closeResetModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !resetModal.hidden) closeResetModal();
    });
    $('#reset-confirm').addEventListener('click', () => {
      try { localStorage.removeItem(STORAGE_KEY); } catch { /* ignore */ }
      location.reload();
    });

    // Pełne złotówki bez końcówki (824 zł), grosze zawsze dwucyfrowo (824,40 zł).
    const fmt = (n: number) => {
      const v = Math.round((Number(n) || 0) * 100) / 100;
      const dec = Number.isInteger(v) ? 0 : 2;
      return v.toLocaleString('pl-PL', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + ' zł';
    };

    const flow = () => FLOWS[state.type ?? 'custom'];
    const stepIndex = (s: StepId) => flow().indexOf(s);

    // ---------------------------------------------------------------- wycena
    // Wycena obejmuje WSZYSTKIE kompletne pozycje (dekor + m² > 0). Arkusze
    // liczone per pozycja, wykonanie/minimum/słój — od sumy m² zamówienia.
    function calcPrice() {
      const list = donePositions();
      if (!list.length) return null;
      const m2 = totalM2();
      const posLines = list.map((p) => {
        // Forner ma mniejsze arkusze niż reszta — powierzchnia idzie z dekoru.
        const sheets = Math.max(1, Math.ceil(p.m2 / (p.sheet!.area || p.producer!.sheetAreaM2)));
        return { name: p.sheet!.name, code: p.sheet!.code, producerName: p.producer!.name,
          ramka: p.ramka, m2: p.m2, sheets, sheetPrice: p.sheet!.price, sheetsCost: sheets * p.sheet!.price };
      });
      const sheetsCost = posLines.reduce((s, l) => s + l.sheetsCost, 0);
      const laborCost = m2 * PRICING.m2Fee;

      let addonsCost = 0;
      const addonLines: { label: string; value: number }[] = [];
      for (const a of PRICING.addons) {
        const qty = state.addons[a.id] || 0;
        if (qty > 0) {
          const v = qty * a.price;
          addonsCost += v;
          addonLines.push({ label: `${a.name} × ${qty}`, value: v });
        }
      }

      const base = sheetsCost + laborCost + addonsCost;
      const grainCost = state.grain ? (base * PRICING.grainMatchPct) / 100 : 0;
      const belowMin = m2 > 0 && m2 < PRICING.minM2 ? (base * PRICING.belowMinPct) / 100 : 0;
      const net = base + grainCost + belowMin;
      const gross = net * (1 + PRICING.vatPct / 100);

      return { m2, posLines, sheetsCost, laborCost, addonLines, grainCost, belowMin, net, gross };
    }

    function renderPrice() {
      const rows: string[] = [];
      const row = (label: string, value: string, muted = false) =>
        `<div class="flex items-baseline justify-between gap-3">
          <dt style="color: var(--color-text-${muted ? 'muted' : 'secondary'});">${label}</dt>
          <dd class="font-heading font-semibold whitespace-nowrap" style="color: var(--color-text);">${value}</dd>
        </div>`;

      const p = calcPrice();
      if (!p) {
        $('#price-breakdown').innerHTML = row('Uzupełnij formatki, aby zobaczyć wycenę', '');
        $('#price-total-net').textContent = '—';
        $('#price-total-gross').textContent = '—';
        $('#mobile-total').textContent = '—';
        $('#min-warning').hidden = true;
        saveState();
        return;
      }

      for (const l of p.posLines) {
        rows.push(row(`Arkusze ${p.posLines.length > 1 ? `(${l.name})` : ''}: ${l.sheets} × ${fmt(l.sheetPrice)}`, fmt(l.sheetsCost)));
      }
      rows.push(row(`Wykonanie: ${fmtM2(p.m2)} m² × ${fmt(PRICING.m2Fee)}`, fmt(p.laborCost)));
      for (const l of p.addonLines) rows.push(row(l.label, fmt(l.value)));
      if (p.grainCost > 0) rows.push(row(`Słój przechodzący (+${PRICING.grainMatchPct}%)`, fmt(p.grainCost)));
      if (p.belowMin > 0) rows.push(row(`Dopłata poniżej ${PRICING.minM2} m² (+${PRICING.belowMinPct}%)`, fmt(p.belowMin)));

      $('#price-breakdown').innerHTML = rows.join('');
      $('#price-total-net').textContent = fmt(p.net);
      $('#price-total-gross').textContent = fmt(p.gross);
      $('#mobile-total').textContent = fmt(p.net);
      $('#min-warning').hidden = !(p.m2 > 0 && p.m2 < PRICING.minM2);
      saveState();
    }

    // ------------------------------------------------------------- nawigacja
    function renderProgress() {
      const steps = flow();
      const nav = $('#wizard-progress');
      nav.innerHTML = '';
      steps.forEach((s, i) => {
        if (i > 0) {
          const sep = document.createElement('span');
          sep.className = 'progress-sep';
          nav.appendChild(sep);
        }
        const idx = stepIndex(currentStep);
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'progress-dot' + (s === currentStep ? ' is-active' : i < idx ? ' is-done' : '');
        dot.innerHTML = `<span class="num">${i < idx ? '✓' : i + 1}</span><span class="hidden sm:inline">${STEP_LABELS[s]}</span>`;
        if (i < idx) dot.addEventListener('click', () => goTo(s));
        else dot.disabled = s !== currentStep;
        nav.appendChild(dot);
      });
    }

    function canLeave(step: StepId): boolean {
      if (step === 'type') return state.type !== null;
      if (step === 'samples') return state.sampleSet !== null;
      if (step === 'producer') return pos().producer !== null;
      if (step === 'catalog') return pos().sheet !== null;
      // dalej można iść, gdy KAŻDA pozycja jest kompletna (dekor + metraż)
      if (step === 'details') return state.positions.every((p) => p.sheet && p.m2 > 0) && totalM2() > 0;
      if (step === 'contact') return validateContact();
      return true;
    }

    function goTo(step: StepId) {
      currentStep = step;
      $$('.wizard-step').forEach((el) => { el.hidden = el.dataset.step !== step; });

      // przygotowanie kroków
      if (step === 'producer') syncProducerSelection();
      if (step === 'catalog') prepareCatalog();
      if (step === 'details') prepareDetails();
      if (step === 'summary') renderSummary();

      // nawigacja dolna
      const nav = $('#wizard-nav');
      const isFirst = step === 'type';
      const isLast = step === 'summary';
      nav.hidden = isFirst;
      $('#btn-back').style.visibility = isFirst ? 'hidden' : 'visible';
      ($('#btn-next') as HTMLButtonElement).hidden = isLast;

      $('#mobile-total-bar').hidden = !(state.type === 'custom' && (step === 'details'));

      renderProgress();
      saveState();
      track('zamowienie_step', { step, order_type: state.type ?? 'unset' });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function next() {
      if (!canLeave(currentStep)) {
        if (currentStep === 'contact') $('#form-error').hidden = false;
        if (currentStep === 'details') $('#m2-error').hidden = false;
        return;
      }
      const steps = flow();
      const i = steps.indexOf(currentStep);
      if (i < steps.length - 1) goTo(steps[i + 1]);
    }
    function back() {
      const steps = flow();
      const i = steps.indexOf(currentStep);
      if (i > 0) goTo(steps[i - 1]);
    }

    $('#btn-next').addEventListener('click', next);
    $('#btn-back').addEventListener('click', back);
    $$('[data-goto]').forEach((el) => el.addEventListener('click', () => goTo(el.dataset.goto as StepId)));

    // --------------------------------------------------------------- krok: typ
    $$('[data-choose-type]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.type = btn.dataset.chooseType as 'samples' | 'custom';
        $$('[data-choose-type]').forEach((b) => b.classList.toggle('is-selected', b === btn));
        setTimeout(next, 180);
      });
    });

    // ------------------------------------------------------------ krok: próbki
    $$('[data-choose-sample]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const z = DATA.zestawy.find((x: any) => x.id === btn.dataset.chooseSample);
        state.sampleSet = z ? { id: z.id, name: z.name } : null;
        $$('[data-choose-sample]').forEach((b) => b.classList.toggle('is-selected', b === btn));
        setTimeout(next, 180);
      });
    });

    // --------------------------------------------------------- krok: producent
    function syncProducerSelection() {
      $$('[data-choose-producer]').forEach((b) =>
        b.classList.toggle('is-selected', b.dataset.chooseProducer === pos().producer?.id));
    }

    $$('[data-choose-producer]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = DATA.producenci.find((x: any) => x.id === btn.dataset.chooseProducer);
        if (pos().producer?.id !== p.id) pos().sheet = null; // zmiana producenta = reset dekoru
        pos().producer = p;
        syncProducerSelection();
        setTimeout(next, 180);
      });
    });

    // ----------------------------------------------------------- krok: katalog
    // Katalog liczy ~500 dekorów, więc kafelki budujemy z JSON-a partiami
    // (PAGE na raz) — inaczej pierwszy render dławi się setkami węzłów DOM.
    type Arkusz = { c: string; n: string; s: string; pr: number; a: number; fm: string; f: string; i: string };
    const PAGE = 48;
    let activeFamily = 'wszystkie';
    let shown = PAGE;
    let searchTimer: number | undefined;

    const m2Price = (a: Arkusz) => a.pr / (a.a || pos().producer?.sheetAreaM2 || 5.8);

    function catalogSource(): Arkusz[] {
      return (pos().producer as any)?.arkusze || [];
    }

    function matching(): Arkusz[] {
      const q = ($('#catalog-search') as HTMLInputElement).value.trim().toLowerCase();
      const list = catalogSource().filter((a) =>
        (activeFamily === 'wszystkie' || a.f === activeFamily)
        && (!q || `${a.c} ${a.n} ${a.s}`.toLowerCase().includes(q)));
      const sort = ($('#catalog-sort') as HTMLSelectElement).value;
      return list.slice().sort((a, b) =>
        sort === 'price-desc' ? b.pr - a.pr
        : sort === 'name' ? a.n.localeCompare(b.n, 'pl')
        : a.pr - b.pr);
    }

    function tileHtml(a: Arkusz, selected: boolean) {
      return `<button type="button" class="decor-tile choice-card card-base rounded-2xl overflow-hidden text-left${selected ? ' is-selected' : ''}"
          data-code="${a.c}" data-name="${a.n.replace(/"/g, '&quot;')}" data-finish="${a.s}" data-price="${a.pr}" data-area="${a.a}" data-format="${a.fm}" data-img="${a.i}">
        <div class="relative">
          <img src="${a.i}" alt="Dekor ${a.n}" width="360" height="270" loading="lazy" decoding="async"
               class="w-full h-28 md:h-32 object-cover" style="background-color: var(--color-bg-tertiary);">
          <span class="absolute bottom-2 left-2 px-2 py-0.5 rounded-md text-2xs font-heading font-semibold tracking-wide"
                style="background: rgba(31,41,55,.78); color:#fff;">${a.c} ${a.s}</span>
        </div>
        <div class="p-4">
          <h3 class="font-heading text-sm font-semibold leading-snug" style="color: var(--color-text);">${a.n}</h3>
          <p class="mt-2 text-sm font-heading font-semibold" style="color: var(--color-accent);">
            ${fmt(a.pr)} <span class="text-2xs font-medium uppercase tracking-wider" style="color: var(--color-text-muted);">netto / arkusz</span>
          </p>
          <p class="text-2xs font-body" style="color: var(--color-text-muted);">${fmt(Math.round(m2Price(a) * 100) / 100)} / m²</p>
        </div>
      </button>`;
    }

    function renderCatalog() {
      const list = matching();
      const slice = list.slice(0, shown);
      const sel = pos().sheet?.code;
      $('#catalog-grid').innerHTML = slice.map((a) => tileHtml(a, a.c === sel)).join('');
      $('#catalog-empty').hidden = list.length > 0;
      ($('#catalog-more') as HTMLButtonElement).hidden = list.length <= shown;
      $('#catalog-count').textContent = list.length
        ? `Pokazano ${slice.length} z ${list.length} dekorów`
        : '';
    }

    function prepareCatalog() {
      if (!pos().producer) return;
      $('#catalog-producer-name').textContent = pos().producer!.name;
      const logo = $('#catalog-producer-logo') as HTMLImageElement;
      logo.src = pos().producer!.logo;
      logo.alt = `Logo ${pos().producer!.name}`;
      logo.hidden = !pos().producer!.logo;

      // chipy rodzin dekorów dostępnych u tego producenta
      const families = ['wszystkie', ...Array.from(new Set(catalogSource().map((a) => a.f)))];
      const filters = $('#catalog-filters');
      filters.innerHTML = '';
      activeFamily = 'wszystkie';
      families.forEach((f) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'filter-chip' + (f === activeFamily ? ' is-selected' : '');
        chip.textContent = f === 'wszystkie' ? 'wszystkie' : (DATA.rodziny[f] || f);
        chip.addEventListener('click', () => {
          activeFamily = f;
          shown = PAGE;
          $$('#catalog-filters .filter-chip').forEach((c) => c.classList.toggle('is-selected', c === chip));
          renderCatalog();
        });
        filters.appendChild(chip);
      });

      ($('#catalog-search') as HTMLInputElement).value = '';
      shown = PAGE;
      renderCatalog();
    }

    $('#catalog-search').addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => { shown = PAGE; renderCatalog(); }, 180);
    });

    $('#catalog-more').addEventListener('click', () => {
      shown += PAGE;
      renderCatalog();
    });

    $('#catalog-sort').addEventListener('change', () => { shown = PAGE; renderCatalog(); });

    // delegacja — kafelki powstają dynamicznie
    $('#catalog-grid').addEventListener('click', (e) => {
      const tile = (e.target as HTMLElement).closest('.decor-tile') as HTMLElement | null;
      if (!tile) return;
      pos().sheet = {
        code: tile.dataset.code!,
        name: tile.dataset.name!,
        finish: tile.dataset.finish!,
        price: Number(tile.dataset.price),
        area: Number(tile.dataset.area) || pos().producer!.sheetAreaM2,
        format: tile.dataset.format || pos().producer!.sheetFormat,
        img: tile.dataset.img!,
      };
      $$('.decor-tile').forEach((t) => t.classList.toggle('is-selected', t === tile));
      setTimeout(next, 180);
    });

    // -------------------------------------------------- krok: formatki/wymiary
    const m2Input = $('#input-m2') as HTMLInputElement;
    const fmtM2 = (n: number) => n.toLocaleString('pl-PL', { maximumFractionDigits: 2 });
    const rowM2 = (r: Formatka) => (r.w >= 50 && r.w <= 2800 && r.h >= 50 && r.h <= 2800 && r.qty >= 1)
      ? (r.w * r.h * r.qty) / 1e6 : 0;

    // ------- lista pozycji (dekorów) na kroku wymiarów -------
    function renderPositions() {
      const box = $('#positions-list');
      box.innerHTML = '';
      state.positions.forEach((p, i) => {
        const item = document.createElement('div');
        item.className = 'position-item' + (i === state.active ? ' is-active' : '');
        const label = p.sheet
          ? `${p.sheet.name} · ${p.sheet.code} <span style="color: var(--color-text-muted);">(${p.producer!.name})</span>`
          : '<span style="color: var(--color-text-muted);">— dekor nie wybrany —</span>';
        item.innerHTML = `
          ${p.sheet?.img
            ? `<img class="pos-swatch object-cover" src="${p.sheet.img}" alt="" width="60" height="60" loading="lazy">`
            : '<span class="pos-swatch" style="background: var(--color-bg-tertiary);"></span>'}
          <span class="flex-1 min-w-0 text-sm font-heading font-semibold truncate" style="color: var(--color-text);">${label}</span>
          <span class="text-xs font-heading font-semibold whitespace-nowrap" style="color: var(--color-text-secondary);">${p.m2 > 0 ? fmtM2(p.m2) + ' m²' : '—'}</span>
          <button type="button" class="pos-edit text-xs font-heading font-semibold" style="color: var(--color-accent);">Zmień dekor</button>
          ${state.positions.length > 1 ? '<button type="button" class="pos-del row-del" title="Usuń pozycję" aria-label="Usuń pozycję">×</button>' : ''}`;
        item.addEventListener('click', () => {
          if (state.active !== i) { state.active = i; prepareDetails(); }
        });
        (item.querySelector('.pos-edit') as HTMLButtonElement).addEventListener('click', (e) => {
          e.stopPropagation();
          state.active = i;
          goTo(p.producer ? 'catalog' : 'producer');
        });
        item.querySelector('.pos-del')?.addEventListener('click', (e) => {
          e.stopPropagation();
          state.positions.splice(i, 1);
          if (state.active >= state.positions.length) state.active = state.positions.length - 1;
          prepareDetails();
        });
        box.appendChild(item);
      });
    }

    $('#btn-add-position').addEventListener('click', () => {
      state.positions.push(newPosition());
      state.active = state.positions.length - 1;
      goTo('producer');
    });

    function applyM2Mode() {
      const manual = pos().m2Mode === 'manual';
      ($('#m2-manual-toggle') as HTMLInputElement).checked = manual;
      $('#manual-m2-box').hidden = !manual;
      $('#formatki-head').hidden = manual;
      $('#formatki-rows').hidden = manual;
      $('#btn-add-row').hidden = manual;
    }

    function renderFormatki() {
      const box = $('#formatki-rows');
      box.innerHTML = '';
      pos().formatki.forEach((r, i) => {
        const row = document.createElement('div');
        row.className = 'grid grid-cols-[1fr_1fr_4rem_4rem_1.75rem] gap-2 items-center';
        row.innerHTML = `
          <input type="number" class="fmt-input" data-f="w" min="50" max="2800" step="1" inputmode="numeric" placeholder="596" value="${r.w || ''}">
          <input type="number" class="fmt-input" data-f="h" min="50" max="2800" step="1" inputmode="numeric" placeholder="715" value="${r.h || ''}">
          <input type="number" class="fmt-input" data-f="qty" min="1" max="500" step="1" inputmode="numeric" value="${r.qty || 1}">
          <span class="row-m2 text-sm font-heading font-semibold text-right" style="color: var(--color-text-secondary);">—</span>
          <button type="button" class="row-del" title="Usuń formatkę" aria-label="Usuń formatkę">×</button>`;
        row.querySelectorAll('input').forEach((inp) => {
          inp.addEventListener('input', () => {
            (r as any)[(inp as HTMLInputElement).dataset.f!] = parseInt((inp as HTMLInputElement).value, 10) || 0;
            updateRowM2(row, r);
            recomputeM2();
          });
        });
        (row.querySelector('.row-del') as HTMLButtonElement).addEventListener('click', () => {
          pos().formatki.splice(i, 1);
          if (!pos().formatki.length) pos().formatki.push({ w: 0, h: 0, qty: 1 });
          renderFormatki();
          recomputeM2();
        });
        box.appendChild(row);
        updateRowM2(row, r);
      });
    }

    function updateRowM2(rowEl: HTMLElement, r: Formatka) {
      const m = rowM2(r);
      (rowEl.querySelector('.row-m2') as HTMLElement).textContent = m ? fmtM2(m) : '—';
    }

    function recomputeM2() {
      const p = pos();
      if (p.m2Mode === 'formatki') {
        const sum = p.formatki.reduce((s, r) => s + rowM2(r), 0);
        p.m2 = Math.round(sum * 100) / 100;
      } else {
        p.m2 = parseFloat(m2Input.value.replace(',', '.')) || 0;
      }
      const total = totalM2();
      $('#m2-display').innerHTML = state.positions.length > 1
        ? `${fmtM2(p.m2)} m² <span class="text-sm font-body" style="color: var(--color-text-muted);">· razem ${fmtM2(total)} m²</span>`
        : fmtM2(p.m2) + ' m²';
      $('#hardware-note').hidden = !(p.m2Mode === 'formatki'
        && p.formatki.some((r) => rowM2(r) > 0 && (r.w > 600 || r.h > 800)));
      if (state.positions.every((x) => x.sheet && x.m2 > 0)) $('#m2-error').hidden = true;
      renderPositions();
      renderPrice(); // renderPrice woła saveState
    }

    function prepareDetails() {
      applyM2Mode();
      m2Input.value = pos().m2Mode === 'manual' && pos().m2 > 0 ? String(pos().m2) : m2Input.value;
      $$('#ramka-options .ramka-chip').forEach((c) => c.classList.toggle('is-selected', c.dataset.ramka === pos().ramka));
      renderFormatki();
      recomputeM2();
    }

    $('#btn-add-row').addEventListener('click', () => {
      pos().formatki.push({ w: 0, h: 0, qty: 1 });
      renderFormatki();
      recomputeM2();
      const last = $('#formatki-rows').lastElementChild?.querySelector('input') as HTMLInputElement | null;
      last?.focus();
    });

    $('#m2-manual-toggle').addEventListener('change', (e) => {
      pos().m2Mode = (e.target as HTMLInputElement).checked ? 'manual' : 'formatki';
      applyM2Mode();
      recomputeM2();
    });

    m2Input.addEventListener('input', recomputeM2);
    $$('[data-m2-delta]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const v = Math.max(0.5, (parseFloat(m2Input.value) || 0) + Number(btn.dataset.m2Delta));
        m2Input.value = String(v);
        recomputeM2();
      });
    });

    $$('#ramka-options .ramka-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        pos().ramka = chip.dataset.ramka!;
        $$('#ramka-options .ramka-chip').forEach((c) => c.classList.toggle('is-selected', c === chip));
        saveState();
      });
    });

    $$('[data-addon]').forEach((input) => {
      input.addEventListener('input', () => {
        state.addons[(input as HTMLInputElement).dataset.addon!] =
          Math.max(0, parseInt((input as HTMLInputElement).value) || 0);
        renderPrice();
      });
    });

    ($('#input-grain') as HTMLInputElement).addEventListener('change', (e) => {
      state.grain = (e.target as HTMLInputElement).checked;
      renderPrice();
    });

    // -------------------------------------------------------------- krok: dane
    const CONTACT_FIELDS = ['name', 'email', 'phone', 'street', 'zip', 'city', 'nip', 'notes'];

    $('#contact-form').addEventListener('input', () => {
      const form = $('#contact-form') as HTMLFormElement;
      CONTACT_FIELDS.forEach((f) => {
        const el = form.elements.namedItem(f) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el) state.contact[f] = el.value.trim();
      });
      saveState();
    });

    function validateContact(): boolean {
      let ok = true;
      const form = $('#contact-form') as HTMLFormElement;
      CONTACT_FIELDS.forEach((f) => {
        const el = form.elements.namedItem(f) as HTMLInputElement | HTMLTextAreaElement | null;
        if (!el) return;
        state.contact[f] = el.value.trim();
        const invalid = el.hasAttribute('required') && !el.value.trim()
          || (f === 'email' && el.value.trim() !== '' && !/^\S+@\S+\.\S+$/.test(el.value.trim()));
        el.classList.toggle('is-invalid', invalid);
        if (invalid) ok = false;
      });
      const consent = $('#f-consent') as HTMLInputElement;
      if (!consent.checked) ok = false;
      if (ok) $('#form-error').hidden = true;
      return ok;
    }

    // ------------------------------------------------------ krok: podsumowanie
    function summaryRow(label: string, value: string) {
      return `<div class="flex items-start justify-between gap-4 py-2.5" style="border-bottom: 1px solid var(--color-border);">
        <span class="text-sm font-body" style="color: var(--color-text-secondary);">${label}</span>
        <span class="text-sm font-heading font-semibold text-right" style="color: var(--color-text);">${value}</span>
      </div>`;
    }

    function renderSummary() {
      const c = state.contact;
      const rows: string[] = [];
      let mailBody = '';

      if (state.type === 'samples') {
        rows.push(summaryRow('Rodzaj zamówienia', 'Próbki'));
        rows.push(summaryRow('Zestaw', state.sampleSet?.name ?? '—'));
        rows.push(summaryRow('Koszt', 'potwierdzimy przy realizacji'));
        mailBody = `ZAMÓWIENIE PRÓBEK — mekra.pl\n\nZestaw: ${state.sampleSet?.name}\n`;
      } else {
        const p = calcPrice()!;
        const list = donePositions();
        rows.push(summaryRow('Rodzaj zamówienia', `Fronty na wymiar${list.length > 1 ? ` · ${list.length} dekory` : ''}`));

        mailBody = `ZAMÓWIENIE — FRONTY NA WYMIAR — mekra.pl\n`;
        list.forEach((posItem, i) => {
          const line = p.posLines[i];
          const fmts = posItem.m2Mode === 'formatki' ? posItem.formatki.filter((r) => rowM2(r) > 0) : [];
          if (list.length > 1) rows.push(`<p class="mt-5 mb-1 text-xs font-heading font-semibold uppercase tracking-widest" style="color: var(--color-text-muted);">Pozycja ${i + 1}</p>`);
          rows.push(summaryRow('Dekor', `${posItem.sheet!.name} · ${posItem.sheet!.code} (${posItem.producer!.name}, ${posItem.sheet!.finish})`));
          rows.push(summaryRow('Grubość ramki', posItem.ramka));
          rows.push(summaryRow('Powierzchnia', `${fmtM2(posItem.m2)} m²`));
          rows.push(summaryRow(`Arkusze (${posItem.sheet!.format || posItem.producer!.sheetFormat} mm)`, `${line.sheets} × ${fmt(line.sheetPrice)} = ${fmt(line.sheetsCost)}`));
          rows.push(summaryRow('Formatki', fmts.length
            ? fmts.map((r) => `${r.w} × ${r.h} mm — ${r.qty} szt.`).join('<br>')
            : 'do uzupełnienia po zamówieniu'));

          mailBody += `\nPOZYCJA ${i + 1}\n`
            + `Dekor: ${posItem.sheet!.name} ${posItem.sheet!.code} (${posItem.producer!.name}, ${posItem.sheet!.finish})\n`
            + `Ramka: ${posItem.ramka}\n`
            + `Powierzchnia: ${fmtM2(posItem.m2)} m²\n`
            + `Arkusze: ${line.sheets} szt.\n`
            + (fmts.length ? `Formatki:\n${fmts.map((r) => `${r.w} × ${r.h} mm — ${r.qty} szt.`).join('\n')}\n` : `Formatki: do uzupełnienia po zamówieniu\n`);
        });

        rows.push(`<p class="mt-5 mb-1 text-xs font-heading font-semibold uppercase tracking-widest" style="color: var(--color-text-muted);">Całe zamówienie</p>`);
        rows.push(summaryRow(`Wykonanie (${fmtM2(p.m2)} m² × ${fmt(PRICING.m2Fee)})`, fmt(p.laborCost)));
        for (const l of p.addonLines) rows.push(summaryRow(l.label, fmt(l.value)));
        if (p.grainCost > 0) rows.push(summaryRow('Słój przechodzący (+20%)', fmt(p.grainCost)));
        if (p.belowMin > 0) rows.push(summaryRow(`Dopłata poniżej ${PRICING.minM2} m²`, fmt(p.belowMin)));

        rows.push(`<div class="flex items-baseline justify-between pt-4 mt-1">
          <span class="font-heading text-sm font-semibold uppercase tracking-wider" style="color: var(--color-text);">Razem netto</span>
          <span class="font-display text-3xl" style="color: var(--color-accent);">${fmt(p.net)}</span>
        </div>
        <div class="flex items-baseline justify-between mt-1">
          <span class="text-sm font-body" style="color: var(--color-text-secondary);">Razem brutto (VAT ${PRICING.vatPct}%)</span>
          <span class="text-sm font-heading font-semibold" style="color: var(--color-text);">${fmt(p.gross)}</span>
        </div>`);

        mailBody += `\nCAŁE ZAMÓWIENIE\n`
          + `Wykonanie: ${fmtM2(p.m2)} m² × ${fmt(PRICING.m2Fee)} = ${fmt(p.laborCost)}\n`
          + p.addonLines.map((l) => `${l.label}: ${fmt(l.value)}\n`).join('')
          + (state.grain ? `Słój przechodzący: tak\n` : '')
          + `Razem netto: ${fmt(p.net)}\nRazem brutto: ${fmt(p.gross)}\n`;
      }

      rows.push(`<p class="mt-6 mb-1 text-xs font-heading font-semibold uppercase tracking-widest" style="color: var(--color-text-muted);">Dane zamawiającego</p>`);
      rows.push(summaryRow('Imię i nazwisko', c.name ?? ''));
      rows.push(summaryRow('Kontakt', `${c.email ?? ''}<br>${c.phone ?? ''}`));
      rows.push(summaryRow('Adres dostawy', `${c.street ?? ''}, ${c.zip ?? ''} ${c.city ?? ''}`));
      if (c.nip) rows.push(summaryRow('NIP', c.nip));
      if (c.notes) rows.push(summaryRow('Uwagi', c.notes));

      $('#summary-card').innerHTML = rows.join('');

      mailBody += `\nDANE ZAMAWIAJĄCEGO\n${c.name}\n${c.email} · ${c.phone}\n${c.street}, ${c.zip} ${c.city}\n`
        + (c.nip ? `NIP: ${c.nip}\n` : '')
        + (c.notes ? `Uwagi: ${c.notes}\n` : '')
        + `\n(Zamówienie złożone przez formularz na mekra.pl — wycena orientacyjna wg cennika.)`;

      const subject = state.type === 'samples'
        ? 'Zamówienie próbek — mekra.pl'
        : 'Zamówienie frontów na wymiar — mekra.pl';
      ($('#summary-mailto') as HTMLAnchorElement).href =
        `mailto:kontakt@mekra.pl?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(mailBody)}`;

      // próbki idą bez płatności; fronty na wymiar przez Stripe
      $('#btn-pay').hidden = state.type !== 'custom';
      $('#btn-submit-samples').hidden = state.type !== 'samples';
      $('#pay-error').hidden = true;
    }

    // ------------------------------------------------- płatność / wysyłka / GA4
    function track(name: string, params: Record<string, any> = {}) {
      try { (window as any).gtag?.('event', name, params); } catch { /* ignore */ }
    }

    function buildOrderPayload() {
      return {
        type: state.type,
        sampleSet: state.sampleSet,
        positions: donePositions().map((p) => ({
          producer: { id: p.producer!.id, name: p.producer!.name, sheetFormat: p.producer!.sheetFormat, sheetAreaM2: p.producer!.sheetAreaM2 },
          sheet: { code: p.sheet!.code, name: p.sheet!.name, finish: p.sheet!.finish, price: p.sheet!.price },
          ramka: p.ramka,
          m2: p.m2,
          m2Mode: p.m2Mode,
          formatki: p.m2Mode === 'formatki' ? p.formatki.filter((r) => rowM2(r) > 0) : [],
        })),
        addons: state.addons,
        grain: state.grain,
        contact: state.contact,
      };
    }

    async function postOrder(path: string) {
      const res = await fetch(DATA.apiBase + path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(buildOrderPayload()),
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.json();
    }

    $('#btn-pay').addEventListener('click', async () => {
      const btn = $('#btn-pay') as HTMLButtonElement;
      const p = calcPrice();
      if (!p) return;
      $('#pay-error').hidden = true;
      btn.disabled = true;
      $('#btn-pay-label').textContent = 'Przekierowuję do płatności…';
      const gaItems = donePositions().map((posItem) => ({
        item_id: posItem.sheet!.code,
        item_name: `Fronty ramiakowe — ${posItem.sheet!.name}`,
        item_brand: posItem.producer!.name,
        quantity: posItem.m2,
      }));
      track('begin_checkout', {
        currency: 'PLN',
        value: Math.round(p.gross * 100) / 100,
        items: gaItems,
      });
      try {
        const { url } = await postOrder('/order/session');
        if (!url) throw new Error('Brak URL sesji płatności');
        // dane do konwersji purchase na stronie podziękowania
        try {
          localStorage.setItem('mekra-order-pending', JSON.stringify({
            gross: Math.round(p.gross * 100) / 100,
            net: Math.round(p.net * 100) / 100,
            m2: p.m2,
            items: gaItems,
          }));
        } catch { /* ignore */ }
        window.location.href = url; // stan zostaje w localStorage na wypadek anulowania
      } catch (e) {
        console.error('Checkout error:', e);
        $('#pay-error').hidden = false;
        btn.disabled = false;
        $('#btn-pay-label').textContent = 'Zamawiam i płacę';
      }
    });

    $('#btn-submit-samples').addEventListener('click', async () => {
      const btn = $('#btn-submit-samples') as HTMLButtonElement;
      $('#pay-error').hidden = true;
      btn.disabled = true;
      $('#btn-samples-label').textContent = 'Wysyłam…';
      try {
        await postOrder('/order/submit');
        track('generate_lead', { lead_type: 'probki' });
        try { localStorage.removeItem(STORAGE_KEY); } catch { /* ignore */ }
        window.location.href = '/zamowienie/dziekujemy/?type=probki';
      } catch (e) {
        console.error('Samples order error:', e);
        $('#pay-error').hidden = false;
        btn.disabled = false;
        $('#btn-samples-label').textContent = 'Wysyłam zamówienie próbek';
      }
    });

    // powrót z anulowanej płatności Stripe — stan i dane czekają w localStorage
    const urlParams = new URLSearchParams(location.search);
    if (urlParams.get('payment') === 'cancelled') {
      history.replaceState(null, '', location.pathname);
      const note = document.createElement('p');
      note.className = 'mb-6 text-center text-sm font-body px-4 py-3 rounded-xl';
      note.style.cssText = 'background-color: var(--color-bg-tertiary); color: var(--color-accent); border: 1px solid var(--color-border);';
      note.textContent = 'Płatność została anulowana — Twoje zamówienie i dane zostały zapamiętane. Możesz dokończyć płatność, kiedy zechcesz.';
      $('#wizard-progress').before(note);
      track('payment_cancelled');
    }

    // start — najpierw próba przywrócenia stanu (np. powrót z płatności / reload)
    restoreState();
    renderProgress();
    updateResetVisibility();
  </script>
</BaseLayout>
