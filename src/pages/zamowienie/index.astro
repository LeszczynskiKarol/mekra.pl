    .filter-chip.is-selected { background-color: var(--color-accent); color: #fff; border-color: var(--color-accent); }

    .form-label {
      display: block; margin-bottom: 0.4rem;
      font-size: 0.8rem; font-weight: 600;
      font-family: 'Outfit', system-ui, sans-serif;
