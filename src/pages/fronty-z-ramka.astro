---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeroPhoto from '../components/PageHeroPhoto.astro';
import { ofertaVariants } from '../data/oferta';
import content from '../content/pages/fronty-z-ramka.json';

const { sections } = content;

// Strona-przewodnik pod frazę „fronty z ramką" (GSC: 321 wyśw., poz. ~16,6 —
// dziś rankuje strona główna bez treści pod tę intencję). Intencja informacyjna;
// stronę katalogową /oferta/ linkujemy jako cel transakcyjny. Fakty wyłącznie
// z publikowanych danych (oferta.ts, Benefits, cennik).
const frameVariants = ofertaVariants.filter((v) => v.slug !== 'zabudowy');

const faq = sections.faq.items;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.title,
    acceptedAnswer: { '@type': 'Answer', text: f.text },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://www.mekra.pl/' },
    { '@type': 'ListItem', position: 2, name: 'Fronty z ramką — przewodnik', item: 'https://www.mekra.pl/fronty-z-ramka/' },
  ],
};
---

<BaseLayout
  title={content.title}
  description={content.description}
  canonicalUrl="https://www.mekra.pl/fronty-z-ramka/"
>
  <Navbar />

  <main class="pt-20 md:pt-24" style="background-color: var(--color-bg);">
    <!-- Hero -->
    <section class="section-padding pt-12 pb-12 md:pt-20 md:pb-16 relative overflow-hidden">
      <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-20 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #ae9070, transparent 70%);"></div>
      <div class="absolute -bottom-20 -right-32 w-96 h-96 rounded-full opacity-15 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #d4c5ae, transparent 70%);"></div>
      <PageHeroPhoto src={sections.hero.image} position="55% 50%" />

      <div class="max-w-7xl mx-auto relative">
        <div class="max-w-3xl">
          <span class="label-tag">{sections.hero.eyebrow}</span>
          <h1 class="mt-6 font-display text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05]" style="color: var(--color-text);" set:html={sections.hero.heading} />
          <p class="mt-6 text-base md:text-lg leading-relaxed font-body" style="color: var(--color-text-secondary);" set:html={sections.hero.text} />
        </div>
      </div>
    </section>

    <!-- Budowa -->
    <section class="section-padding py-12 md:py-20" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-5xl mx-auto">
        <div class="max-w-3xl">
          <span class="label-tag">{sections.budowa.eyebrow}</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            {sections.budowa.heading}
          </h2>
        </div>
        <div class="mt-10 grid sm:grid-cols-2 gap-5">
          {sections.budowa.items.map((item) => (
            <div class="card-base rounded-2xl p-6">
              <h3 class="font-heading text-base font-semibold" style="color: var(--color-text);">{item.title}</h3>
              <p class="mt-2 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={item.text} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Szerokości -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl">
          <span class="label-tag">{sections.szerokosci.eyebrow}</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            {sections.szerokosci.heading}
          </h2>
          <p class="mt-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);">
            {sections.szerokosci.text}
          </p>
        </div>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {frameVariants.map((v) => (
            <a href={`/oferta/${v.slug}/`} class="card-base rounded-2xl p-6 block transition-transform hover:-translate-y-1">
              <p class="font-display text-3xl" style="color: var(--color-accent);">{v.size}&nbsp;{v.unit}</p>
              <h3 class="mt-2 font-heading text-base font-semibold" style="color: var(--color-text);">{v.name}</h3>
              <p class="mt-2 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">{v.tagline}</p>
              <p class="mt-3 text-xs font-body leading-relaxed" style="color: var(--color-text-muted);">{v.bestFor}</p>
            </a>
          ))}
        </div>
        <p class="mt-6 text-sm font-body" style="color: var(--color-text-secondary);" set:html={sections.szerokosci.caption} />
      </div>
    </section>

    <!-- Laminat vs lakier -->
    <section class="section-padding py-12 md:py-20" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto text-center">
        <span class="label-tag">{sections.material.eyebrow}</span>
        <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
          {sections.material.heading}
        </h2>
        <p class="mt-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={sections.material.text} />
        <div class="mt-8">
          <a href="/fronty-laminowane-czy-lakierowane/" class="btn-secondary">{sections.material.ctaLabel}</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <span class="label-tag">{sections.faq.eyebrow}</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            {sections.faq.heading}
          </h2>
        </div>
        <div class="space-y-4">
          {faq.map((f) => (
            <div class="card-base rounded-2xl p-6 md:p-8">
              <h3 class="font-heading text-base font-semibold" style="color: var(--color-text);">{f.title}</h3>
              <p class="mt-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding py-16 md:py-24" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);">
          {sections.cta.heading}
        </h2>
        <p class="mt-4 text-base md:text-lg font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={sections.cta.text} />
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={sections.cta.items[0].href} class="btn-primary">{sections.cta.items[0].label}</a>
          <a href={sections.cta.items[1].href} class="btn-secondary">{sections.cta.items[1].label}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
