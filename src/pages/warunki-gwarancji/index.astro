---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHeroPhoto from '../../components/PageHeroPhoto.astro';

// Treść: „Warunki techniczne i gwarancyjne — MEKRA Fronty Meblowe"
const techParams = [
  {
    title: 'Krzywizna frontu',
    value: '±1 mm',
    description: 'Standardowa dopuszczalna krzywizna (strzałka ugięcia) frontu o wysokości poniżej 800 mm.',
  },
  {
    title: 'Tolerancja wymiarowa',
    value: '±1 mm',
    description: 'Margines tolerancji szerokości i wysokości gotowego produktu.',
  },
  {
    title: 'Oklejanie krawędzi',
    value: 'Klej PUR',
    description: 'Wszystkie produkty oklejamy wilgocioodpornym klejem poliuretanowym PUR.',
  },
  {
    title: 'Fronty wysokie',
    value: '> 800 mm',
    description: 'Przy elementach powyżej 800 mm wysokości (i szerokości powyżej 600 mm) wymagane są okucia napinające lub zwiększona liczba zawiasów — konstrukcja ramkowa z płyty laminowanej nie gwarantuje wtedy pełnej sztywności.',
  },
];

const estetyka = [
  'Możliwe są rozbieżności między próbnikiem lub wzornikiem a produktem finalnym.',
  'Naturalne są różnice w połyskliwości i teksturze między powierzchnią płyty a materiałem ramek wykończeniowych.',
  'Rozbieżności kolorystyczne w obrębie tej samej grupy dekorów to cecha technologiczna procesu laminowania — nie stanowią podstawy do roszczeń.',
];

const ocenaWarunki = [
  { label: 'Norma', text: 'Dopuszczalność mikrowad powierzchniowych na laminacie określa norma DIN EN 14323 (oświetlenie 800–1000 luksów).' },
  { label: 'Pozycja', text: 'Element oceniany jest w pozycji docelowej (pionowej lub poziomej), przy rozproszonym świetle dziennym.' },
  { label: 'Odległość', text: 'Obserwacja z odległości od 0,5 m do 1,0 m — zgodnie z wewnętrznym standardem opartym na wytycznych PN-F-06001-3.' },
  { label: 'Kryterium', text: 'Za wadę uznaje się jedynie defekty widoczne nieuzbrojonym okiem w powyższych warunkach. Zmiana kąta patrzenia przy nieruchomym elemencie jest dopuszczalna.' },
];

const pielegnacjaDo = [
  'Do codziennego czyszczenia używaj miękkich, bezszwowych ściereczek z mikrowłókna.',
  'Najbezpieczniejszy środek na co dzień to słaby roztwór wody z mydłem (stężenie ok. 1%).',
  'Stosuj zasadę „suchej krawędzi": po czyszczeniu na mokro od razu wytrzyj front do sucha, szczególnie szczeliny przy nakładanych ramkach — to chroni płytę przed pęcznieniem.',
  'Powierzchnie połyskowe odświeżaj dedykowanymi mleczkami polimerowymi — tworzą warstwę antystatyczną i chronią przed odciskami palców.',
  'Do powierzchni matowych używaj środków dedykowanych do matu, które nie nabłyszczają i wspomagają powłokę Anti-Fingerprint.',
  'Resztki kleju lub tłuszczu usuwaj profesjonalnymi środkami czyszczącymi — zawsze po próbie w niewidocznym miejscu.',
  'Uporczywy osad na frontach matowych możesz usunąć preparatem intensywnym: niewielką ilość nanieś na wilgotną mikrofibrę, przetrzyj bez szorowania, zmyj wodą i wytrzyj do sucha. Nie stosuj do codziennej pielęgnacji.',
];

const pielegnacjaDont = [
  'Nie rozpakowuj paczek ostrymi nożami ani narzędziami punktowymi — ryzyko przecięcia folii i trwałego uszkodzenia laminatu lub ramy jest wysokie.',
  'Nie pisz po folii ani po frontach mazakami, długopisami czy markerami — barwniki mogą trwale wniknąć w laminat (szczególnie matowy).',
  'Nie używaj szorstkich gąbek (druciaków) ani ręczników papierowych — matowią laminat.',
  'Nie stosuj środków ze ścierniwem (mleczka z piaskiem), rozpuszczalników, octu ani silnych kwasów.',
  'Nie czyść frontów płynami do szyb z alkoholem — mogą powodować smugi i mikrospękania na ramkach.',
  'Nie używaj wosków i nabłyszczaczy meblowych nieprzeznaczonych do laminatów — zostawiają tłuste, trudne do usunięcia warstwy.',
];

const gwarancja = [
  {
    title: 'Okres gwarancji',
    value: '2 lata',
    description: 'Udzielamy 2-letniej gwarancji na nasze wyroby. Bieg gwarancji rozpoczyna się w dniu wystawienia dokumentu sprzedaży.',
  },
  {
    title: 'Weryfikacja przy odbiorze',
    value: '14 dni',
    description: 'Sprawdź towar pod kątem ilości, wymiarów i wad widocznych w ciągu 14 dni od dostawy. Obróbka mechaniczna (wiercenie, cięcie) frontu z wadą jawną oznacza akceptację towaru i utratę prawa do reklamacji w tym zakresie.',
  },
  {
    title: 'Procedura reklamacyjna',
    value: 'Pisemnie',
    description: 'Reklamację zgłoś pisemnie wraz z dokumentacją zdjęciową. Zastrzegamy sobie prawo do oględzin reklamowanego elementu w naszej siedzibie.',
  },
  {
    title: 'Zakres odpowiedzialności',
    value: 'Wartość produktu',
    description: 'Odpowiedzialność Mekra ogranicza się do wartości reklamowanego produktu. Nie pokrywamy kosztów montażu, transportu wtórnego ani przestojów.',
  },
];
---

<BaseLayout
  title="Warunki techniczne i gwarancyjne — fronty ramiakowe Mekra"
  description="Warunki techniczne i gwarancyjne frontów ramiakowych Mekra: parametry techniczne, standardy oceny jakości, zasady pielęgnacji laminatu, 2-letnia gwarancja i procedura reklamacyjna."
  canonicalUrl="https://www.mekra.pl/warunki-gwarancji/"
>
  <Navbar />

  <main class="pt-20 md:pt-24" style="background-color: var(--color-bg);">
    <!-- Hero -->
    <section class="section-padding pt-12 pb-12 md:pt-20 md:pb-16 relative overflow-hidden">
      <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-20 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #ae9070, transparent 70%);"></div>
      <div class="absolute -bottom-20 -right-32 w-96 h-96 rounded-full opacity-15 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #d4c5ae, transparent 70%);"></div>
      <PageHeroPhoto src="/img/mekra-produkcja.webp" position="50% 40%" />

      <div class="max-w-7xl mx-auto relative">
        <div class="max-w-3xl">
          <span class="label-tag">Dla klienta</span>
          <h1 class="mt-6 font-display text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05]" style="color: var(--color-text);">
            Warunki techniczne<br />
            <span class="text-gradient">i gwarancyjne</span>
          </h1>
          <p class="mt-6 text-base md:text-lg leading-relaxed font-body" style="color: var(--color-text-secondary);">
            Wszystko, co warto wiedzieć o&nbsp;parametrach naszych frontów, standardach oceny
            jakości, prawidłowej pielęgnacji laminatu oraz zasadach gwarancji i&nbsp;reklamacji.
          </p>

          <!-- Quick anchors -->
          <div class="mt-8 flex flex-wrap gap-2">
            {[
              { href: '#normy', label: 'Normy jakościowe' },
              { href: '#pielegnacja', label: 'Pielęgnacja' },
              { href: '#gwarancja', label: 'Gwarancja' },
              { href: '#zwroty', label: 'Zwroty' },
            ].map((a) => (
              <a
                href={a.href}
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-body font-medium transition-all duration-200 hover:scale-105"
                style="border: 1px solid var(--color-border); color: var(--color-text-secondary); background-color: var(--color-card-bg);"
              >
                {a.label}
              </a>
            ))}
          </div>

          <div class="mt-8">
            <a
              href="/docs/warunki-techniczne-i-gwarancyjne-mekra.pdf"
              download
              class="inline-flex items-center gap-2.5 px-5 py-3 rounded-xl text-sm font-heading font-semibold transition-all duration-300 hover:scale-[1.02]"
              style="border: 1.5px solid var(--color-border); color: var(--color-text); background-color: var(--color-card-bg);"
            >
              <svg class="w-5 h-5" style="color: var(--color-accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v2.625a3.375 3.375 0 01-3.375 3.375h-8.25A3.375 3.375 0 014.5 16.875V14.25M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5" />
              </svg>
              Pobierz dokument PDF
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Normy jakościowe -->
    <section id="normy" class="section-padding py-12 md:py-16 scroll-mt-24">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-12">
          <span class="label-tag">01 · Normy jakościowe i produkcyjne</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            Parametry techniczne frontów
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          {techParams.map((p, i) => (
            <div class="animate-on-scroll card-base rounded-2xl p-6 md:p-8" style={`transition-delay: ${i * 0.06}s;`}>
              <span class="font-display text-3xl" style="color: var(--color-accent);">{p.value}</span>
              <h3 class="mt-3 font-heading text-lg font-semibold" style="color: var(--color-text);">{p.title}</h3>
              <p class="mt-2 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">{p.description}</p>
            </div>
          ))}
        </div>

        <!-- Wybarwienie i estetyka -->
        <div class="mt-6 animate-on-scroll card-base rounded-2xl p-6 md:p-8">
          <h3 class="font-heading text-lg font-semibold" style="color: var(--color-text);">Wybarwienie i&nbsp;estetyka</h3>
          <p class="mt-2 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">
            Laminowanie to proces technologiczny, który dopuszcza pewne naturalne odchylenia:
          </p>
          <ul class="mt-4 space-y-3">
            {estetyka.map((e) => (
              <li class="flex gap-3 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: var(--color-accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
                </svg>
                <span>{e}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Standardy oceny -->
        <div class="mt-6 animate-on-scroll card-base rounded-2xl p-6 md:p-8">
          <h3 class="font-heading text-lg font-semibold" style="color: var(--color-text);">Jak oceniamy jakość powierzchni?</h3>
          <div class="mt-5 grid sm:grid-cols-2 gap-x-8 gap-y-5">
            {ocenaWarunki.map((o) => (
              <div>
                <span class="block text-xs font-heading font-semibold tracking-widest uppercase" style="color: var(--color-accent);">{o.label}</span>
                <p class="mt-1.5 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">{o.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Pielęgnacja -->
    <section id="pielegnacja" class="section-padding py-12 md:py-16 scroll-mt-24" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-12">
          <span class="label-tag">02 · Eksploatacja i pielęgnacja</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            Jak dbać o&nbsp;fronty laminowane?
          </h2>
          <p class="mt-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);">
            Przy płytach laminowanych z&nbsp;ramkami kluczowe jest unikanie nadmiaru wilgoci
            w&nbsp;miejscach łączeń. Poza tym pielęgnacja jest prosta — wystarczy trzymać się kilku zasad.
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-6">
          <!-- DO -->
          <div class="animate-on-scroll card-base rounded-2xl p-6 md:p-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background-color: var(--color-bg-tertiary); color: var(--color-accent);">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <h3 class="font-heading text-lg font-semibold" style="color: var(--color-text);">Zalecamy</h3>
            </div>
            <ul class="space-y-3.5">
              {pielegnacjaDo.map((item) => (
                <li class="flex gap-3 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: var(--color-accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- DON'T -->
          <div class="animate-on-scroll card-base rounded-2xl p-6 md:p-8" style="transition-delay: 0.08s;">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background-color: var(--color-bg-tertiary); color: var(--color-text-muted);">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </div>
              <h3 class="font-heading text-lg font-semibold" style="color: var(--color-text);">Czego unikać? (zakazy gwarancyjne)</h3>
            </div>
            <ul class="space-y-3.5">
              {pielegnacjaDont.map((item) => (
                <li class="flex gap-3 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Gwarancja -->
    <section id="gwarancja" class="section-padding py-12 md:py-16 scroll-mt-24">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-2xl mb-12">
          <span class="label-tag">03 · Warunki gwarancji</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            Gwarancja Mekra
          </h2>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          {gwarancja.map((g, i) => (
            <div class="animate-on-scroll card-base rounded-2xl p-6 md:p-8" style={`transition-delay: ${i * 0.06}s;`}>
              <span class="font-display text-3xl" style="color: var(--color-accent);">{g.value}</span>
              <h3 class="mt-3 font-heading text-lg font-semibold" style="color: var(--color-text);">{g.title}</h3>
              <p class="mt-2 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">{g.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Zwroty -->
    <section id="zwroty" class="section-padding py-12 md:py-16 scroll-mt-24" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-7xl mx-auto">
        <div class="animate-on-scroll card-base rounded-3xl p-8 md:p-12">
          <span class="label-tag">04 · Produkty na wymiar i zwroty</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            Produkcja na indywidualne zamówienie
          </h2>
          <div class="mt-6 max-w-3xl space-y-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);">
            <p>
              Wszystkie produkty Mekra wytwarzamy na indywidualne zamówienie, według specyfikacji
              klienta — pod konkretny wymiar i&nbsp;kolor. Z&nbsp;tego powodu
              <strong style="color: var(--color-text);"> zwrot zamówionych frontów nie jest możliwy</strong>.
            </p>
            <p>
              Zgodnie z&nbsp;art. 38 pkt 3 Ustawy o&nbsp;prawach konsumenta, prawo do odstąpienia od umowy
              zawartej na odległość nie przysługuje w&nbsp;przypadku zamówień dotyczących rzeczy
              nieprefabrykowanych, wyprodukowanych według specyfikacji konsumenta lub służących
              zaspokojeniu jego zindywidualizowanych potrzeb.
            </p>
            <p>
              Masz wątpliwości co do wymiarów lub dekoru? Skontaktuj się z&nbsp;nami przed złożeniem
              zamówienia — doradzimy i&nbsp;pomożemy uniknąć pomyłek.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/#kontakt" class="btn-primary">Skontaktuj się</a>
            <a href="/cennik/" class="btn-secondary">Zobacz cennik</a>
            <a href="/docs/warunki-techniczne-i-gwarancyjne-mekra.pdf" download class="btn-secondary">Pobierz PDF</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
