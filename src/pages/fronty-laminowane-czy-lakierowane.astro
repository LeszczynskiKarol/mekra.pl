---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeroPhoto from '../components/PageHeroPhoto.astro';
import content from '../content/pages/fronty-laminowane-czy-lakierowane.json';

const { sections } = content;

// Porównanie oparte wyłącznie na argumentacji publikowanej w sekcji Korzyści
// (Benefits.astro) — bez nowych deklaracji produkcyjnych.
// Wiersze tabeli: name = cecha, text = laminat, value = lakier, type = zwycięzca.
const rows = sections.tabela.items;

const faq = sections.faq.items;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.title,
    acceptedAnswer: { '@type': 'Answer', text: f.text },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://www.mekra.pl/' },
    { '@type': 'ListItem', position: 2, name: 'Fronty laminowane czy lakierowane?', item: 'https://www.mekra.pl/fronty-laminowane-czy-lakierowane/' },
  ],
};
---

<BaseLayout
  title={content.title}
  description={content.description}
  canonicalUrl="https://www.mekra.pl/fronty-laminowane-czy-lakierowane/"
>
  <Navbar />

  <main class="pt-20 md:pt-24" style="background-color: var(--color-bg);">
    <!-- Hero -->
    <section class="section-padding pt-12 pb-12 md:pt-20 md:pb-16 relative overflow-hidden">
      <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-20 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #ae9070, transparent 70%);"></div>
      <div class="absolute -bottom-20 -right-32 w-96 h-96 rounded-full opacity-15 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #d4c5ae, transparent 70%);"></div>
      <PageHeroPhoto src={sections.hero.image} position="55% 45%" />

      <div class="max-w-7xl mx-auto relative">
        <div class="max-w-3xl">
          <span class="label-tag">{sections.hero.eyebrow}</span>
          <h1 class="mt-6 font-display text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05]" style="color: var(--color-text);" set:html={sections.hero.heading} />
          <p class="mt-6 text-base md:text-lg leading-relaxed font-body" style="color: var(--color-text-secondary);" set:html={sections.hero.text} />
        </div>
      </div>
    </section>

    <!-- Tabela porównawcza -->
    <section class="section-padding pb-12 md:pb-20">
      <div class="max-w-5xl mx-auto">
        <div class="overflow-x-auto rounded-2xl" style="border: 1px solid var(--color-border); background-color: var(--color-card-bg);">
          <table class="w-full min-w-[680px]">
            <thead>
              <tr style="background-color: var(--color-bg-tertiary);">
                <th class="text-left py-4 px-6 font-heading text-sm font-semibold" style="color: var(--color-text);">{sections.tabela.bullets[0]}</th>
                <th class="text-left py-4 px-6 font-heading text-sm font-semibold" style="color: var(--color-accent);">{sections.tabela.bullets[1]}</th>
                <th class="text-left py-4 px-6 font-heading text-sm font-semibold" style="color: var(--color-text);">{sections.tabela.bullets[2]}</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr style="border-top: 1px solid var(--color-border);">
                  <td class="py-4 px-6 font-heading text-sm font-medium" style="color: var(--color-text);">{r.name}</td>
                  <td class="py-4 px-6 text-sm font-body" style={`color: ${r.type === 'laminat' ? 'var(--color-accent)' : 'var(--color-text-secondary)'};`}>
                    {r.text}
                  </td>
                  <td class="py-4 px-6 text-sm font-body" style={`color: ${r.type === 'lakier' ? 'var(--color-accent)' : 'var(--color-text-secondary)'};`}>
                    {r.value}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs font-body" style="color: var(--color-text-muted);">
          {sections.tabela.caption}
        </p>
      </div>
    </section>

    <!-- Kiedy co wybrać -->
    <section class="section-padding py-12 md:py-20" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-6">
        <div class="card-base rounded-2xl p-8">
          <h2 class="font-heading text-xl font-semibold" style="color: var(--color-text);">{sections.wybierzLakier.heading}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">
            {sections.wybierzLakier.bullets.map((b) => (<li set:html={b} />))}
          </ul>
        </div>
        <div class="card-base rounded-2xl p-8">
          <h2 class="font-heading text-xl font-semibold" style="color: var(--color-text);">{sections.wybierzLaminat.heading}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">
            {sections.wybierzLaminat.bullets.map((b) => (<li set:html={b} />))}
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <span class="label-tag">{sections.faq.eyebrow}</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            {sections.faq.heading}
          </h2>
        </div>
        <div class="space-y-4">
          {faq.map((f) => (
            <div class="card-base rounded-2xl p-6 md:p-8">
              <h3 class="font-heading text-base font-semibold" style="color: var(--color-text);">{f.title}</h3>
              <p class="mt-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding py-16 md:py-24" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);">
          {sections.cta.heading}
        </h2>
        <p class="mt-4 text-base md:text-lg font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={sections.cta.text} />
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={sections.cta.items[0].href} class="btn-primary">{sections.cta.items[0].label}</a>
          <a href={sections.cta.items[1].href} class="btn-secondary">{sections.cta.items[1].label}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
