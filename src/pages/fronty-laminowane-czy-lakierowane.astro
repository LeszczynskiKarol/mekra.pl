---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Porównanie oparte wyłącznie na argumentacji publikowanej w sekcji Korzyści
// (Benefits.astro) — bez nowych deklaracji produkcyjnych.
const rows = [
  { aspekt: 'Odporność na zarysowania i uderzenia', laminat: 'Najtwardszy materiał na rynku meblowym', lakier: 'Delikatny — łatwo zarysować i uszkodzić', winner: 'laminat' },
  { aspekt: 'Faktura powierzchni', laminat: 'Wyczuwalna struktura drewna, maty, akryle', lakier: 'Gładka, bez struktury materiału', winner: 'laminat' },
  { aspekt: 'Dekor od wewnątrz szafki', laminat: 'Dwustronny dekor w standardzie', lakier: 'Kolor tylko z zewnątrz, od środka biały/czarny MDF', winner: 'laminat' },
  { aspekt: 'Paleta wykończeń', laminat: 'Setki dekorów: drewno, kamień, beton, unikolory', lakier: 'Jednobarwny — dowolny kolor, ale bez struktur', winner: 'laminat' },
  { aspekt: 'Ramka w połysku', laminat: 'Standardowa opcja', lakier: 'Praktycznie niemożliwa do wykonania', winner: 'laminat' },
  { aspekt: 'Krawędź frontu', laminat: 'Doklejana, oklejana klejem PUR', lakier: 'Zalana — malowana w całości', winner: 'lakier' },
  { aspekt: 'Zdobienia i sztukaterie', laminat: 'Ograniczone do formy ramiaka', lakier: 'Dowolne frezowania i zdobienia', winner: 'lakier' },
  { aspekt: 'Cena', laminat: 'Od 350 zł/m² netto', lakier: 'Zwykle tańszy w prostych formach', winner: 'lakier' },
];

const faq = [
  {
    q: 'Czy Mekra wykonuje fronty lakierowane?',
    a: 'Nie — nie lakierujemy frontów. Jesteśmy producentem frontów ramiakowych z płyty laminowanej, którą traktujemy jako trwalszą alternatywę dla MDF lakierowanego: ten sam klasyczny wygląd ramki, wielokrotnie większa odporność i dwustronny dekor.',
  },
  {
    q: 'Kiedy fronty lakierowane mają przewagę?',
    a: 'Gdy zależy Ci na zalanej (malowanej w całości) krawędzi bez doklejki albo na ozdobnych frezowaniach i sztukateriach — tego laminat nie odtworzy. Lakier bywa też tańszy w najprostszych formach.',
  },
  {
    q: 'Kiedy lepszy będzie front laminowany?',
    a: 'W kuchni i wszędzie tam, gdzie front dostaje uderzenia i zarysowania — laminat jest wielokrotnie twardszy od lakieru. Do tego wyczuwalna struktura drewna, dwustronny dekor, ramki w połysku (w lakierze praktycznie niewykonalne) i setki dekorów do wyboru.',
  },
  {
    q: 'Czy front laminowany wygląda jak lakierowany?',
    a: 'W szerokościach ramki 36 i 60 mm forma jest identyczna jak w klasycznym MDF lakierowanym — różnicę widać dopiero z bliska, a czuć w fakturze i odporności. Ramka 60 mm pozwala dodatkowo wpuścić lustro lub szkło w środek frontu.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://www.mekra.pl/' },
    { '@type': 'ListItem', position: 2, name: 'Fronty laminowane czy lakierowane?', item: 'https://www.mekra.pl/fronty-laminowane-czy-lakierowane/' },
  ],
};
---

<BaseLayout
  title="Fronty laminowane czy lakierowane? Uczciwe porównanie"
  description="Fronty laminowane czy lakierowane (MDF)? Porównujemy odporność, fakturę, krawędzie, paletę dekorów i cenę. Uczciwie — łącznie z tym, kiedy lakier wygrywa. Producent frontów ramiakowych — Toruń."
  canonicalUrl="https://www.mekra.pl/fronty-laminowane-czy-lakierowane/"
>
  <Navbar />

  <main class="pt-20 md:pt-24" style="background-color: var(--color-bg);">
    <!-- Hero -->
    <section class="section-padding pt-12 pb-12 md:pt-20 md:pb-16 relative overflow-hidden">
      <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-20 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #ae9070, transparent 70%);"></div>
      <div class="absolute -bottom-20 -right-32 w-96 h-96 rounded-full opacity-15 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #d4c5ae, transparent 70%);"></div>

      <div class="max-w-7xl mx-auto relative">
        <div class="max-w-3xl">
          <span class="label-tag">Porównanie</span>
          <h1 class="mt-6 font-display text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05]" style="color: var(--color-text);">
            Fronty laminowane<br />
            <span class="text-gradient">czy lakierowane?</span>
          </h1>
          <p class="mt-6 text-base md:text-lg leading-relaxed font-body" style="color: var(--color-text-secondary);">
            Od razu uczciwie: <strong style="color: var(--color-text);">nie lakierujemy frontów</strong>.
            Produkujemy <a href="/oferta/fronty-laminowane/" class="font-medium hover:underline" style="color: var(--color-accent);">fronty laminowane</a>
            w&nbsp;formie <a href="/fronty-z-ramka/" class="font-medium hover:underline" style="color: var(--color-accent);">ramiaka</a> — bo uważamy je za trwalszą alternatywę dla MDF lakierowanego.
            Ale lakier ma swoje realne zalety i&nbsp;uczciwe porównanie musi je uwzględnić.
            Poniżej zestawienie, które pomoże Ci wybrać świadomie.
          </p>
        </div>
      </div>
    </section>

    <!-- Tabela porównawcza -->
    <section class="section-padding pb-12 md:pb-20">
      <div class="max-w-5xl mx-auto">
        <div class="overflow-x-auto rounded-2xl" style="border: 1px solid var(--color-border); background-color: var(--color-card-bg);">
          <table class="w-full min-w-[680px]">
            <thead>
              <tr style="background-color: var(--color-bg-tertiary);">
                <th class="text-left py-4 px-6 font-heading text-sm font-semibold" style="color: var(--color-text);">Cecha</th>
                <th class="text-left py-4 px-6 font-heading text-sm font-semibold" style="color: var(--color-accent);">Front laminowany (ramiak)</th>
                <th class="text-left py-4 px-6 font-heading text-sm font-semibold" style="color: var(--color-text);">Front MDF lakierowany</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr style="border-top: 1px solid var(--color-border);">
                  <td class="py-4 px-6 font-heading text-sm font-medium" style="color: var(--color-text);">{r.aspekt}</td>
                  <td class="py-4 px-6 text-sm font-body" style={`color: ${r.winner === 'laminat' ? 'var(--color-accent)' : 'var(--color-text-secondary)'};`}>
                    {r.laminat}
                  </td>
                  <td class="py-4 px-6 text-sm font-body" style={`color: ${r.winner === 'lakier' ? 'var(--color-accent)' : 'var(--color-text-secondary)'};`}>
                    {r.lakier}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs font-body" style="color: var(--color-text-muted);">
          Kolorem oznaczono materiał, który w danej kategorii wypada lepiej.
        </p>
      </div>
    </section>

    <!-- Kiedy co wybrać -->
    <section class="section-padding py-12 md:py-20" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-6">
        <div class="card-base rounded-2xl p-8">
          <h2 class="font-heading text-xl font-semibold" style="color: var(--color-text);">Wybierz lakier, jeśli…</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">
            <li>— zależy Ci na zalanej krawędzi, malowanej w&nbsp;całości, bez doklejki,</li>
            <li>— projekt wymaga ozdobnych frezowań, sztukaterii i&nbsp;nietypowych zdobień,</li>
            <li>— front będzie w&nbsp;miejscu mało narażonym na uderzenia i&nbsp;zarysowania.</li>
          </ul>
        </div>
        <div class="card-base rounded-2xl p-8">
          <h2 class="font-heading text-xl font-semibold" style="color: var(--color-text);">Wybierz laminat, jeśli…</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">
            <li>— front ma pracować w&nbsp;kuchni i&nbsp;znosić codzienne uderzenia — laminat jest wielokrotnie twardszy od lakieru,</li>
            <li>— chcesz czuć strukturę drewna pod dłonią i&nbsp;mieć dekor z&nbsp;obu stron frontu,</li>
            <li>— marzy Ci się ramka w&nbsp;połysku albo dekor drewna, kamienia czy betonu — tego lakier nie odtworzy,</li>
            <li>— w&nbsp;ramce 60&nbsp;mm chcesz wpuścić <a href="/oferta/ramka-60mm/" class="font-medium hover:underline" style="color: var(--color-accent);">lustro lub szkło w&nbsp;środek frontu</a>.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <span class="label-tag">FAQ</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            Najczęstsze pytania
          </h2>
        </div>
        <div class="space-y-4">
          {faq.map((f) => (
            <div class="card-base rounded-2xl p-6 md:p-8">
              <h3 class="font-heading text-base font-semibold" style="color: var(--color-text);">{f.q}</h3>
              <p class="mt-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding py-16 md:py-24" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);">
          Zobacz, jak wygląda ramiak z laminatu
        </h2>
        <p class="mt-4 text-base md:text-lg font-body leading-relaxed" style="color: var(--color-text-secondary);">
          Najlepiej porównuje się na realnych projektach — obejrzyj nasze realizacje
          albo od razu poproś o&nbsp;wycenę swojego projektu.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/realizacje/" class="btn-primary">Zobacz realizacje</a>
          <a href="/oferta/" class="btn-secondary">Fronty ramiakowe — oferta</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
