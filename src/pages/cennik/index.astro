---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHeroPhoto from '../../components/PageHeroPhoto.astro';
import content from '../../content/pages/cennik.json';

const { sections } = content;

// Pozycje cennika — źródło: src/content/pages/cennik.json (edytowalne w CMS)
const mainOffer = sections.pozycjaGlowna;

const addons = sections.dodatki.items;

const infoItems = sections.info.items;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Cennik frontów ramiakowych Mekra',
  url: 'https://www.mekra.pl/cennik/',
  itemListElement: [
    {
      '@type': 'Offer',
      position: 1,
      name: 'Fronty ramiakowe 7/18/36/60 mm',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: 350,
        priceCurrency: 'PLN',
        unitText: 'm²',
        valueAddedTaxIncluded: false,
      },
      description: 'Fronty ramiakowe z płyty laminowanej — cena od 350 zł/m² netto, zależna od dekoru.',
    },
  ],
};
---

<BaseLayout
  title={content.title}
  description={content.description}
  canonicalUrl="https://www.mekra.pl/cennik/"
>
  <Navbar />

  <main class="pt-20 md:pt-24" style="background-color: var(--color-bg);">
    <!-- Hero -->
    <section class="section-padding pt-12 pb-12 md:pt-20 md:pb-16 relative overflow-hidden">
      <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-20 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #ae9070, transparent 70%);"></div>
      <div class="absolute -bottom-20 -right-32 w-96 h-96 rounded-full opacity-15 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #d4c5ae, transparent 70%);"></div>

      <PageHeroPhoto src={sections.hero.image} position="70% 45%" />

      <div class="max-w-7xl mx-auto relative">
        <div class="max-w-3xl">
          <span class="label-tag">{sections.hero.eyebrow}</span>
          <h1 class="mt-6 font-display text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05]" style="color: var(--color-text);" set:html={sections.hero.heading} />
          <p class="mt-6 text-base md:text-lg leading-relaxed font-body" style="color: var(--color-text-secondary);" set:html={sections.hero.text} />

          <div class="mt-8">
            <a
              href="/docs/cennik-mekra.pdf"
              download
              class="inline-flex items-center gap-2.5 px-5 py-3 rounded-xl text-sm font-heading font-semibold transition-all duration-300 hover:scale-[1.02]"
              style="border: 1.5px solid var(--color-border); color: var(--color-text); background-color: var(--color-card-bg);"
            >
              <svg class="w-5 h-5" style="color: var(--color-accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v2.625a3.375 3.375 0 01-3.375 3.375h-8.25A3.375 3.375 0 014.5 16.875V14.25M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5" />
              </svg>
              {sections.hero.ctaLabel}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Main price card -->
    <section class="section-padding pb-12">
      <div class="max-w-7xl mx-auto">
        <div class="animate-on-scroll card-base rounded-3xl overflow-hidden">
          <div class="grid lg:grid-cols-[1fr_auto] items-center gap-6 p-8 md:p-12">
            <div>
              <span class="label-tag">{sections.pozycjaGlowna.eyebrow}</span>
              <h2 class="mt-5 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
                {mainOffer.name}
              </h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {mainOffer.sizes.split(' / ').map((s) => (
                  <span class="inline-flex items-baseline gap-0.5 px-3 py-1.5 rounded-full text-sm font-heading font-semibold" style="background-color: var(--color-bg-tertiary); color: var(--color-accent); border: 1px solid var(--color-border);">
                    {s.replace(' mm', '')}<span class="text-[10px] uppercase tracking-wider opacity-80">mm</span>
                  </span>
                ))}
              </div>
              <p class="mt-4 text-base font-body leading-relaxed max-w-xl" style="color: var(--color-text-secondary);">
                {mainOffer.text}
              </p>
            </div>
            <div class="lg:text-right lg:pl-10" style="border-left: none;">
              <div class="flex lg:justify-end items-baseline gap-2">
                <span class="font-display text-5xl md:text-6xl" style="color: var(--color-accent);">{mainOffer.value}</span>
              </div>
              <span class="block mt-2 font-heading text-sm font-medium tracking-wider uppercase" style="color: var(--color-text-muted);">
                / {mainOffer.unit}
              </span>
              <a href="/#kontakt" class="btn-primary mt-6">{mainOffer.ctaLabel}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Addons grid -->
    <section class="section-padding py-12 md:py-16" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="label-tag">{sections.dodatki.eyebrow}</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);" set:html={sections.dodatki.heading} />
          <p class="mt-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);">
            {sections.dodatki.text}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {addons.map((a, i) => (
            <div class="animate-on-scroll card-base rounded-2xl p-6 md:p-8 flex flex-col" style={`transition-delay: ${i * 0.06}s;`}>
              <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background-color: var(--color-bg-tertiary); color: var(--color-accent);">
                {a.type === 'glass' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75h16.5v16.5H3.75z M3.75 9h16.5 M9 3.75v16.5" />
                  </svg>
                )}
                {a.type === 'mirror' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z M8.25 9.75l3-3 M8.25 14.25l6-6" />
                  </svg>
                )}
                {a.type === 'angle' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15 M4.5 19.5h15 M9.75 19.5a5.25 5.25 0 00-5.25-5.25" />
                  </svg>
                )}
                {a.type === 'grain' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 6c4-2 8-2 12 0s6 2 6 2M3 12c4-2 8-2 12 0s6 2 6 2M3 18c4-2 8-2 12 0s6 2 6 2" />
                  </svg>
                )}
                {a.type === 'minimum' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                  </svg>
                )}
              </div>
              <h3 class="font-heading text-lg font-semibold" style="color: var(--color-text);">{a.name}</h3>
              <p class="mt-2 text-sm font-body leading-relaxed flex-1" style="color: var(--color-text-secondary);">
                {a.text}
              </p>
              <div class="mt-5 pt-5 flex items-baseline gap-2" style="border-top: 1px solid var(--color-border);">
                <span class="font-display text-3xl" style="color: var(--color-accent);">{a.value}</span>
                <span class="text-xs font-heading font-medium tracking-wider uppercase" style="color: var(--color-text-muted);">{a.unit}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Good to know -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-10 lg:gap-16 items-start">
          <div class="lg:sticky lg:top-28">
            <span class="label-tag">{sections.info.eyebrow}</span>
            <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);" set:html={sections.info.heading} />
            <p class="mt-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={sections.info.text} />
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={sections.infoCta.items[0].href} class="btn-primary">{sections.infoCta.items[0].label}</a>
              <a href={sections.infoCta.items[1].href} class="btn-secondary">{sections.infoCta.items[1].label}</a>
            </div>
          </div>

          <div class="space-y-4">
            {infoItems.map((item, i) => (
              <div class="animate-on-scroll card-base rounded-2xl p-6 flex gap-4" style={`transition-delay: ${i * 0.05}s;`}>
                <div class="w-9 h-9 rounded-lg flex-shrink-0 flex items-center justify-center" style="background-color: var(--color-bg-tertiary); color: var(--color-accent);">
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading text-base font-semibold" style="color: var(--color-text);">{item.title}</h3>
                  <p class="mt-1 text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);">{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding py-16 md:py-24" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);">
          {sections.cta.heading}
        </h2>
        <p class="mt-4 text-base md:text-lg font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={sections.cta.text} />
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={sections.cta.items[0].href} class="btn-primary">{sections.cta.items[0].label}</a>
          <a href={sections.cta.items[1].href} class="btn-secondary">{sections.cta.items[1].label}</a>
          <a href={sections.cta.items[2].href} download class="btn-secondary">{sections.cta.items[2].label}</a>
        </div>
        <p class="mt-6 text-xs font-body" style="color: var(--color-text-muted);" set:html={sections.cta.caption} />
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
