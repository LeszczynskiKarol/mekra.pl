---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import manifest from '../../data/realizacje.json';
import { projects } from '../../data/projects';
import { ofertaVariants } from '../../data/oferta';

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { project: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { items, categories } = manifest;

const projectItems = items.filter((it) => it.projectSlug === project.slug);
const photoCount = projectItems.length;
const hero = projectItems[0];
const ofertaVariant = ofertaVariants.find((v) => v.slug === project.category);
const categoryMeta = categories[project.category];

// prev / next project navigation within same site
const projectIndex = projects.findIndex((p) => p.slug === project.slug);
const prevProject = projects[(projectIndex - 1 + projects.length) % projects.length];
const nextProject = projects[(projectIndex + 1) % projects.length];

const canonicalUrl = `https://www.mekra.pl/realizacje/${project.slug}/`;

const creativeWorkLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.intro,
  url: canonicalUrl,
  creator: { '@type': 'Organization', name: 'Mekra', url: 'https://www.mekra.pl' },
  ...(project.location ? { contentLocation: { '@type': 'Place', name: project.location } } : {}),
  image: projectItems.slice(0, 10).map((it) => `https://www.mekra.pl${it.paths.full}`),
  about: {
    '@type': 'Product',
    name: ofertaVariant ? `${ofertaVariant.name} — ramka ${ofertaVariant.size}${ofertaVariant.unit}` : project.title,
    brand: { '@type': 'Brand', name: 'Mekra' },
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://www.mekra.pl/' },
    { '@type': 'ListItem', position: 2, name: 'Realizacje', item: 'https://www.mekra.pl/realizacje/' },
    { '@type': 'ListItem', position: 3, name: project.title, item: canonicalUrl },
  ],
};

const seoDescription = `${project.intro} ${photoCount} zdjęć, realizacja Mekra — producent frontów ramiakowych z Torunia.`.slice(0, 158);
---

<BaseLayout
  title={project.title}
  description={seoDescription}
  canonicalUrl={canonicalUrl}
  ogImage={hero ? `https://www.mekra.pl${hero.paths.full}` : undefined}
  preloadImage={hero?.paths.thumbWebp ?? hero?.paths.thumb}
  preloadImageType={hero?.paths.thumbWebp ? 'image/webp' : 'image/jpeg'}
  preloadImageSrcset={hero ? `${hero.paths.thumbWebp} 800w, ${hero.paths.fullWebp} 1920w` : undefined}
  preloadImageSizes="(min-width: 1024px) 50vw, 100vw"
>
  <Navbar />

  <main class="pt-20 md:pt-24" style="background-color: var(--color-bg);">
    <!-- Breadcrumb -->
    <nav class="section-padding pt-6 pb-4" aria-label="Breadcrumb">
      <div class="max-w-7xl mx-auto">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-body" style="color: var(--color-text-muted);">
          <li><a href="/" class="hover:text-[var(--color-accent)] transition-colors">Strona główna</a></li>
          <li>›</li>
          <li><a href="/realizacje/" class="hover:text-[var(--color-accent)] transition-colors">Realizacje</a></li>
          <li>›</li>
          <li style="color: var(--color-text-secondary);">{project.subtitle}</li>
        </ol>
      </div>
    </nav>

    <!-- Hero -->
    <section class="section-padding pt-6 pb-12 md:pt-10 md:pb-20">
      <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          <div class="lg:col-span-6">
            <span class="label-tag">
              Realizacja
              {project.location && (
                <span class="ml-1 font-heading font-semibold" style="color: var(--color-accent);">{project.location}</span>
              )}
            </span>
            <h1 class="mt-6 font-display text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05]" style="color: var(--color-text);">
              {project.title}
            </h1>
            <p class="mt-4 text-lg font-body" style="color: var(--color-text-secondary);">
              {project.subtitle} — {photoCount} zdjęć
            </p>
            <p class="mt-6 text-base md:text-lg leading-relaxed font-body" style="color: var(--color-text-secondary);">
              {project.intro}
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/#kontakt" class="btn-primary">Zamów wycenę</a>
              {ofertaVariant && (
                <a href={`/oferta/${ofertaVariant.slug}/`} class="btn-secondary">
                  Zobacz wariant {ofertaVariant.size}{ofertaVariant.unit}
                </a>
              )}
            </div>
          </div>

          {hero && (
            <div class="lg:col-span-6">
              <div class="relative rounded-3xl overflow-hidden aspect-[4/5] sm:aspect-[3/2] lg:aspect-[4/5] card-base">
                <picture>
                  <source
                    type="image/webp"
                    srcset={`${hero.paths.thumbWebp} 800w, ${hero.paths.fullWebp} 1920w`}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                  />
                  <img
                    src={hero.paths.thumb}
                    srcset={`${hero.paths.thumb} 800w, ${hero.paths.full} 1920w`}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    alt={hero.alt}
                    width={hero.thumbWidth}
                    height={hero.thumbHeight}
                    class="w-full h-full object-cover"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                </picture>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Long-form description -->
    <section class="section-padding py-12 md:py-20" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto">
        <span class="label-tag">O tej realizacji</span>
        <h2 class="mt-4 font-display text-2xl sm:text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);">
          Co znajdziesz w tym projekcie
        </h2>
        <div class="mt-8 space-y-5 text-base md:text-lg font-body leading-relaxed" style="color: var(--color-text-secondary);">
          {project.body.map((p) => (<p>{p}</p>))}
        </div>
      </div>
    </section>

    <!-- Gallery — all project photos -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-end justify-between gap-6 mb-10">
          <div>
            <span class="label-tag">Galeria</span>
            <h2 class="mt-4 font-display text-2xl sm:text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);">
              Wszystkie zdjęcia ({photoCount})
            </h2>
          </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
          {projectItems.map((it, i) => (
            <article
              class="gallery-card block aspect-[4/5] rounded-xl overflow-hidden group relative"
              style="background-color: var(--color-bg-secondary);"
              data-gallery-index={i}
              role="button"
              tabindex="0"
              aria-label={`Otwórz zdjęcie: ${it.project}`}
            >
              <picture>
                <source srcset={it.paths.thumbWebp} type="image/webp" />
                <img
                  src={it.paths.thumb}
                  alt={it.alt}
                  width={it.thumbWidth}
                  height={it.thumbHeight}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading={i < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </picture>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Prev / Next -->
    <section class="section-padding py-12 md:py-16" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-5xl mx-auto grid sm:grid-cols-2 gap-6">
        <a href={`/realizacje/${prevProject.slug}/`} class="card-base rounded-2xl p-6 group">
          <div class="text-xs uppercase tracking-[0.15em] font-body" style="color: var(--color-text-muted);">← Poprzednia realizacja</div>
          <div class="mt-3 font-heading text-lg font-semibold" style="color: var(--color-text);">
            {prevProject.title}
          </div>
        </a>
        <a href={`/realizacje/${nextProject.slug}/`} class="card-base rounded-2xl p-6 group text-right">
          <div class="text-xs uppercase tracking-[0.15em] font-body" style="color: var(--color-text-muted);">Następna realizacja →</div>
          <div class="mt-3 font-heading text-lg font-semibold" style="color: var(--color-text);">
            {nextProject.title}
          </div>
        </a>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);">
          Chcesz podobny projekt?
        </h2>
        <p class="mt-4 text-base md:text-lg font-body leading-relaxed" style="color: var(--color-text-secondary);">
          Wyślij wymiary lub opisz, co masz w&nbsp;głowie. Odpowiemy w&nbsp;24h z propozycją dekoru i&nbsp;wstępną wyceną.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/#kontakt" class="btn-primary">Zamów wycenę</a>
          <a href="/realizacje/" class="btn-secondary">Wszystkie realizacje</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Lightbox -->
  <div id="gallery-lightbox" class="gallery-lightbox" aria-hidden="true" role="dialog" aria-label="Podgląd zdjęcia">
    <div class="gallery-lightbox__backdrop" data-lightbox-close></div>

    <button class="gallery-lightbox__close" data-lightbox-close aria-label="Zamknij">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <button class="gallery-lightbox__nav gallery-lightbox__nav--prev" data-lightbox-prev aria-label="Poprzednie zdjęcie">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>

    <button class="gallery-lightbox__nav gallery-lightbox__nav--next" data-lightbox-next aria-label="Następne zdjęcie">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>

    <div class="gallery-lightbox__content">
      <picture>
        <source id="lightbox-img-webp" srcset="" type="image/webp" />
        <img id="lightbox-img" class="gallery-lightbox__img" src="" alt="" />
      </picture>
      <div class="gallery-lightbox__caption">
        <p id="lightbox-category" class="text-[10px] uppercase tracking-[0.15em] text-white/50 font-body mb-1"></p>
        <p id="lightbox-caption" class="font-heading font-medium text-sm text-white"></p>
        <p id="lightbox-counter" class="text-xs text-white/50 mt-1 font-body"></p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(creativeWorkLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>

<style>
  /* ── Lightbox (shared with realizacje/index.astro) ── */
  .gallery-lightbox {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none; opacity: 0; visibility: hidden;
    transition: opacity 0.35s cubic-bezier(0.4,0,0.2,1), visibility 0.35s cubic-bezier(0.4,0,0.2,1);
  }
  .gallery-lightbox.is-open { pointer-events: auto; opacity: 1; visibility: visible; }
  .gallery-lightbox__backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.92);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  }
  .gallery-lightbox__close {
    position: absolute; top: 1.25rem; right: 1.25rem; z-index: 10;
    width: 2.75rem; height: 2.75rem;
    display: flex; align-items: center; justify-content: center;
    border-radius: 9999px;
    background: rgba(255,255,255,0.1); color: white;
    border: 1px solid rgba(255,255,255,0.15); cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .gallery-lightbox__close:hover { background: rgba(255,255,255,0.2); transform: scale(1.05); }
  .gallery-lightbox__nav {
    position: absolute; top: 50%; z-index: 10; transform: translateY(-50%);
    width: 3rem; height: 3rem;
    display: flex; align-items: center; justify-content: center;
    border-radius: 9999px;
    background: rgba(255,255,255,0.08); color: white;
    border: 1px solid rgba(255,255,255,0.12); cursor: pointer;
    transition: background 0.2s;
  }
  .gallery-lightbox__nav:hover { background: rgba(255,255,255,0.18); }
  .gallery-lightbox__nav--prev { left: 1rem; }
  .gallery-lightbox__nav--next { right: 1rem; }
  @media (min-width: 768px) {
    .gallery-lightbox__nav--prev { left: 1.5rem; }
    .gallery-lightbox__nav--next { right: 1.5rem; }
    .gallery-lightbox__close { top: 1.5rem; right: 1.5rem; }
  }
  .gallery-lightbox__content {
    position: relative; z-index: 5;
    display: flex; flex-direction: column; align-items: center;
    max-width: calc(100vw - 6rem); max-height: calc(100vh - 6rem);
  }
  @media (max-width: 767px) {
    .gallery-lightbox__content {
      max-width: calc(100vw - 1.5rem);
      max-height: calc(100vh - 4rem);
    }
  }
  .gallery-lightbox__img {
    max-width: 100%; max-height: calc(100vh - 10rem);
    object-fit: contain; border-radius: 0.75rem;
    box-shadow: 0 25px 60px rgba(0,0,0,0.5);
    transform: scale(0.92) translateY(12px); opacity: 0;
    transition: transform 0.4s cubic-bezier(0.4,0,0.2,1), opacity 0.35s cubic-bezier(0.4,0,0.2,1);
  }
  .gallery-lightbox.is-open .gallery-lightbox__img {
    transform: scale(1) translateY(0); opacity: 1;
  }
  .gallery-lightbox__img.is-switching {
    transform: scale(0.96); opacity: 0; transition-duration: 0.18s;
  }
  .gallery-lightbox__caption {
    text-align: center; margin-top: 1rem;
    transform: translateY(8px); opacity: 0;
    transition: transform 0.4s cubic-bezier(0.4,0,0.2,1) 0.1s, opacity 0.35s cubic-bezier(0.4,0,0.2,1) 0.1s;
  }
  .gallery-lightbox.is-open .gallery-lightbox__caption {
    transform: translateY(0); opacity: 1;
  }
  .gallery-lightbox__caption.is-switching {
    opacity: 0; transform: translateY(4px); transition-duration: 0.15s; transition-delay: 0s;
  }

  /* Gallery cards act as buttons */
  .gallery-card { cursor: pointer; }
  .gallery-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>

<script define:vars={{ galleryItems: projectItems, categoryTitle: categoryMeta?.title ?? project.subtitle }}>
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('gallery-lightbox');
    if (!lightbox) return;
    const lbImg = document.getElementById('lightbox-img');
    const lbWebp = document.getElementById('lightbox-img-webp');
    const lbCaption = document.getElementById('lightbox-caption');
    const lbCategory = document.getElementById('lightbox-category');
    const lbCounter = document.getElementById('lightbox-counter');
    const cards = Array.from(document.querySelectorAll('.gallery-card'));
    let pos = 0;
    let isAnimating = false;

    function applyImage(item) {
      lbWebp.srcset = item.paths.fullWebp;
      lbImg.src = item.paths.full;
      lbImg.alt = item.alt;
      lbCategory.textContent = categoryTitle;
      lbCaption.textContent = item.project;
      lbCounter.textContent = `${pos + 1} / ${galleryItems.length}`;
    }

    function openLightbox(index) {
      pos = index;
      applyImage(galleryItems[pos]);
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function transitionTo(newPos) {
      if (isAnimating) return;
      isAnimating = true;
      lbImg.classList.add('is-switching');
      lbCaption.parentElement.classList.add('is-switching');
      setTimeout(() => {
        pos = newPos;
        applyImage(galleryItems[pos]);
        requestAnimationFrame(() => {
          lbImg.classList.remove('is-switching');
          lbCaption.parentElement.classList.remove('is-switching');
          setTimeout(() => { isAnimating = false; }, 300);
        });
      }, 200);
    }

    function goNext() { transitionTo((pos + 1) % galleryItems.length); }
    function goPrev() { transitionTo((pos - 1 + galleryItems.length) % galleryItems.length); }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        openLightbox(parseInt(card.dataset.galleryIndex, 10));
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(parseInt(card.dataset.galleryIndex, 10));
        }
      });
    });

    document.querySelectorAll('[data-lightbox-close]').forEach((el) => {
      el.addEventListener('click', closeLightbox);
    });
    document.querySelector('[data-lightbox-prev]').addEventListener('click', goPrev);
    document.querySelector('[data-lightbox-next]').addEventListener('click', goNext);

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') goNext();
      if (e.key === 'ArrowLeft') goPrev();
    });

    let touchStartX = 0;
    lightbox.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    lightbox.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) goNext(); else goPrev();
      }
    }, { passive: true });
  });
</script>
