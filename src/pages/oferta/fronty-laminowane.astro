---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { ofertaVariants } from '../../data/oferta';

const frameVariants = ofertaVariants.filter((v) => v.slug !== 'zabudowy');

const zalety = [
  {
    title: 'Najwyższa odporność',
    description:
      'Płyta laminowana to najtwardszy materiał dostępny na rynku meblowym — odporna na zarysowania, odbarwienia i uszkodzenia mechaniczne. Wielokrotnie twardsza niż lakier MDF.',
  },
  {
    title: 'Wyczuwalna faktura',
    description:
      'Gładka, perlistowa, super matowa, metalizowana, szczotkowana lub z wyczuwalną strukturą drewna — faktura frontu jest taka, jaki materiał wybierzesz.',
  },
  {
    title: 'Dwustronny dekor',
    description:
      'Obie strony frontu pokryte tym samym dekorem — od wewnątrz szafki front wygląda tak samo jak od zewnątrz. W lakierze widzisz kolor tylko z zewnątrz.',
  },
  {
    title: 'Klej PUR w standardzie',
    description:
      'Wszystkie krawędzie oklejamy wodoodpornym, odpornym na temperaturę klejem poliuretanowym PUR — bez dopłat. Fronty przy zmywarkach zabezpieczamy dodatkowo.',
  },
  {
    title: 'Setki dekorów',
    description:
      'Unikolory, reprodukcje drewna, kamienia i betonu. Płyty głęboko strukturyzowane (Saviola, Egger, Forner Cleaf) oraz maty i akryle (Forner, AGT) w trzech wykończeniach: ultramat, mat, połysk.',
  },
  {
    title: 'Ekologia i recykling',
    description:
      'Płyty laminowane w części pochodzą z recyklingu — wybierając fronty laminowane, stawiasz na odpowiedzialne rozwiązanie.',
  },
];

const faq = [
  {
    q: 'Ile kosztują fronty laminowane na wymiar?',
    a: 'Fronty ramiakowe z płyty laminowanej kosztują od 350 zł/m² netto — cena zależy od wybranego dekoru, dlatego każde zamówienie wyceniamy indywidualnie. Dopłaty dotyczą frontów ze szkłem lub lustrem oraz zacinania na 45°. Pełne stawki znajdziesz w cenniku.',
  },
  {
    q: 'Z jakich płyt laminowanych wykonujecie fronty?',
    a: 'Z każdej płyty laminowanej dostępnej na rynku — laminaty, folie PPV i akryle w połysku. Pracujemy m.in. na płytach Egger, Kronospan, Swiss Krono i Forner, a w dekorach strukturalnych na kolekcjach Saviola i Forner Cleaf.',
  },
  {
    q: 'Czy wysyłacie fronty laminowane poza Toruń?',
    a: 'Tak — gotowe fronty wysyłamy kurierem pod wskazany adres w całej Polsce. W promieniu 100 km od Torunia oferujemy również wymiarowanie na miejscu. Fronty ze szkłem lub lustrem o dużym gabarycie dostarczamy transportem dedykowanym.',
  },
  {
    q: 'Jaki jest czas realizacji zamówienia?',
    a: 'Standardowo 8–10 tygodni od potwierdzenia specyfikacji. Minimum logistyczne to 4 m² — mniejsze zamówienia realizujemy z dopłatą 30% wartości zamówienia netto. Za słój przechodzący (zachowanie ciągłości usłojenia między frontami) doliczamy 20% wartości zamówienia netto.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://www.mekra.pl/' },
    { '@type': 'ListItem', position: 2, name: 'Oferta', item: 'https://www.mekra.pl/oferta/' },
    { '@type': 'ListItem', position: 3, name: 'Fronty laminowane', item: 'https://www.mekra.pl/oferta/fronty-laminowane/' },
  ],
};
---

<BaseLayout
  title="Fronty laminowane na wymiar — producent frontów meblowych"
  description="Fronty laminowane na wymiar z każdej płyty dostępnej na rynku: Egger, Kronospan, Swiss Krono, Forner. Fronty ramiakowe 7–60 mm, dwustronny dekor, klej PUR. Od 350 zł/m². Producent — Toruń, wysyłka w całej Polsce."
  canonicalUrl="https://www.mekra.pl/oferta/fronty-laminowane/"
>
  <Navbar />

  <main class="pt-20 md:pt-24" style="background-color: var(--color-bg);">
    <!-- Breadcrumb -->
    <nav class="section-padding pt-6 pb-0" aria-label="Breadcrumb">
      <div class="max-w-7xl mx-auto">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-body" style="color: var(--color-text-muted);">
          <li><a href="/" class="hover:text-[var(--color-accent)] transition-colors">Strona główna</a></li>
          <li>›</li>
          <li><a href="/oferta/" class="hover:text-[var(--color-accent)] transition-colors">Oferta</a></li>
          <li>›</li>
          <li style="color: var(--color-text-secondary);">Fronty laminowane</li>
        </ol>
      </div>
    </nav>

    <!-- Hero -->
    <section class="section-padding pt-8 pb-12 md:pt-12 md:pb-16 relative overflow-hidden">
      <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-20 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #ae9070, transparent 70%);"></div>
      <div class="absolute -bottom-20 -right-32 w-96 h-96 rounded-full opacity-15 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #d4c5ae, transparent 70%);"></div>

      <div class="max-w-7xl mx-auto relative">
        <div class="max-w-3xl">
          <span class="label-tag">Materiał</span>
          <h1 class="mt-6 font-display text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05]" style="color: var(--color-text);">
            Fronty laminowane<br />
            <span class="text-gradient">na wymiar, od producenta</span>
          </h1>
          <p class="mt-6 text-base md:text-lg leading-relaxed font-body" style="color: var(--color-text-secondary);">
            Produkujemy fronty meblowe z&nbsp;każdej płyty laminowanej dostępnej na rynku —
            laminaty, folie PPV i&nbsp;akryle w&nbsp;połysku. Wszystkie w&nbsp;formie
            <a href="/oferta/" class="font-medium hover:underline" style="color: var(--color-accent);">frontów ramiakowych</a>
            z&nbsp;ramką 7, 18, 36 lub 60&nbsp;mm, z&nbsp;dwustronnym dekorem i&nbsp;klejem PUR
            w&nbsp;standardzie. Toruń i&nbsp;okolice — wymiarowanie na miejscu, reszta Polski — wysyłka kurierem.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/#kontakt" class="btn-primary">Zamów wycenę</a>
            <a href="/cennik/" class="btn-secondary">Zobacz cennik</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Zalety -->
    <section class="section-padding py-12 md:py-20" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="label-tag">Dlaczego laminat</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            Co dają fronty laminowane?
          </h2>
          <p class="mt-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);">
            Odporność, faktura i&nbsp;paleta dekorów, których nie da lakier ani folia.
            Porównanie z&nbsp;innymi materiałami znajdziesz na stronie
            <a href="/fronty-laminowane-czy-lakierowane/" class="font-medium hover:underline" style="color: var(--color-accent);">fronty laminowane czy lakierowane</a>.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {zalety.map((z) => (
            <div class="card-base rounded-2xl p-6 md:p-8">
              <h3 class="font-heading text-lg font-semibold" style="color: var(--color-text);">{z.title}</h3>
              <p class="mt-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">{z.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Warianty ramek -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="label-tag">Wykonanie</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            Cztery szerokości ramki do wyboru
          </h2>
          <p class="mt-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);">
            Każdy front laminowany wykonujemy w&nbsp;formie ramiaka — wybierz szerokość ramki
            dopasowaną do stylu wnętrza.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {frameVariants.map((v) => (
            <a href={`/oferta/${v.slug}/`} class="card-base rounded-2xl p-6 block group" style="text-decoration: none;">
              <div class="flex items-baseline gap-2">
                <span class="font-display text-4xl" style="color: var(--color-accent);">{v.size}</span>
                <span class="font-heading text-xs uppercase tracking-wider" style="color: var(--color-text-muted);">{v.unit}</span>
              </div>
              <h3 class="mt-3 font-heading text-base font-semibold" style="color: var(--color-text);">
                Fronty laminowane z&nbsp;ramką {v.size}&nbsp;{v.unit}
              </h3>
              <p class="mt-2 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">{v.tagline}</p>
              <div class="mt-4 inline-flex items-center gap-1.5 text-sm font-heading font-medium" style="color: var(--color-accent);">
                <span>Zobacz wariant</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Płyty i dekory -->
    <section class="section-padding py-12 md:py-20" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto">
        <span class="label-tag">Płyty i dekory</span>
        <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
          Każda płyta laminowana z rynku
        </h2>
        <div class="mt-6 space-y-4 text-base leading-relaxed font-body" style="color: var(--color-text-secondary);">
          <p>
            Nie ograniczamy Cię do własnego katalogu — wykonamy fronty z&nbsp;każdej płyty laminowanej
            dostępnej na rynku. Na co dzień pracujemy na płytach <strong style="color: var(--color-text);">Egger, Kronospan,
            Swiss Krono i&nbsp;Forner</strong>.
          </p>
          <p>
            Do wyboru masz setki dekorów: unikolory, reprodukcje drewna, kamienia i&nbsp;betonu.
            Płyty głęboko strukturyzowane (Saviola, Egger, Forner Cleaf) oddają charakter prawdziwego
            drewna — strukturę czuć pod dłonią. Maty akrylowe i&nbsp;akryle (Forner, AGT) to jednolite
            wybarwienia w&nbsp;trzech wykończeniach: ultramat głęboko pochłaniający światło, klasyczny
            mat oraz połysk.
          </p>
          <p>
            Wszystkie fronty mają grubość 21&nbsp;mm i&nbsp;pracują na standardowych zawiasach Blum,
            Häfele i&nbsp;Hettich. Zasady pielęgnacji laminatu i&nbsp;warunki gwarancji opisaliśmy
            w&nbsp;<a href="/warunki-gwarancji/" class="font-medium hover:underline" style="color: var(--color-accent);">warunkach gwarancji</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <span class="label-tag">FAQ</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            Najczęstsze pytania
          </h2>
        </div>
        <div class="space-y-4">
          {faq.map((f) => (
            <div class="card-base rounded-2xl p-6 md:p-8">
              <h3 class="font-heading text-base font-semibold" style="color: var(--color-text);">{f.q}</h3>
              <p class="mt-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding py-16 md:py-24" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);">
          Wyceń swoje fronty laminowane
        </h2>
        <p class="mt-4 text-base md:text-lg font-body leading-relaxed" style="color: var(--color-text-secondary);">
          Wyślij wymiary lub opisz projekt — odpowiemy w&nbsp;24h z&nbsp;propozycją dekoru,
          szerokości ramki i&nbsp;wstępną wyceną.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/#kontakt" class="btn-primary">Zamów wycenę</a>
          <a href="/realizacje/" class="btn-secondary">Zobacz realizacje</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
