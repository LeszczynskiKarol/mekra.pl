---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHeroPhoto from '../../components/PageHeroPhoto.astro';
import { ofertaVariants } from '../../data/oferta';
import content from '../../content/pages/oferta/fronty-laminowane-page.json';

const { sections } = content;

const frameVariants = ofertaVariants.filter((v) => v.slug !== 'zabudowy');

const zalety = sections.zalety.items;

const faq = sections.faq.items;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.title,
    acceptedAnswer: { '@type': 'Answer', text: f.text },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://www.mekra.pl/' },
    { '@type': 'ListItem', position: 2, name: 'Oferta', item: 'https://www.mekra.pl/oferta/' },
    { '@type': 'ListItem', position: 3, name: 'Fronty laminowane', item: 'https://www.mekra.pl/oferta/fronty-laminowane/' },
  ],
};
---

<BaseLayout
  title={content.title}
  description={content.description}
  canonicalUrl="https://www.mekra.pl/oferta/fronty-laminowane/"
>
  <Navbar />

  <main class="pt-20 md:pt-24" style="background-color: var(--color-bg);">
    <!-- Breadcrumb -->
    <nav class="section-padding pt-6 pb-0" aria-label="Breadcrumb">
      <div class="max-w-7xl mx-auto">
        <ol class="flex flex-wrap items-center gap-2 text-xs font-body" style="color: var(--color-text-muted);">
          <li><a href={sections.breadcrumb.items[0].href} class="hover:text-[var(--color-accent)] transition-colors">{sections.breadcrumb.items[0].label}</a></li>
          <li>›</li>
          <li><a href={sections.breadcrumb.items[1].href} class="hover:text-[var(--color-accent)] transition-colors">{sections.breadcrumb.items[1].label}</a></li>
          <li>›</li>
          <li style="color: var(--color-text-secondary);">{sections.breadcrumb.items[2].label}</li>
        </ol>
      </div>
    </nav>

    <!-- Hero -->
    <section class="section-padding pt-8 pb-12 md:pt-12 md:pb-16 relative overflow-hidden">
      <div class="absolute top-20 -left-32 w-96 h-96 rounded-full opacity-20 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #ae9070, transparent 70%);"></div>
      <div class="absolute -bottom-20 -right-32 w-96 h-96 rounded-full opacity-15 dark:opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #d4c5ae, transparent 70%);"></div>

      <PageHeroPhoto src={sections.hero.image} position="72% 45%" />

      <div class="max-w-7xl mx-auto relative">
        <div class="max-w-3xl">
          <span class="label-tag">{sections.hero.eyebrow}</span>
          <h1 class="mt-6 font-display text-4xl sm:text-5xl md:text-6xl tracking-tight leading-[1.05]" style="color: var(--color-text);" set:html={sections.hero.heading} />
          <p class="mt-6 text-base md:text-lg leading-relaxed font-body" style="color: var(--color-text-secondary);" set:html={sections.hero.text} />
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={sections.hero.items[0].href} class="btn-primary">{sections.hero.items[0].label}</a>
            <a href={sections.hero.items[1].href} class="btn-secondary">{sections.hero.items[1].label}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Zalety -->
    <section class="section-padding py-12 md:py-20" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="label-tag">{sections.zalety.eyebrow}</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            {sections.zalety.heading}
          </h2>
          <p class="mt-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={sections.zalety.text} />
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {zalety.map((z) => (
            <div class="card-base rounded-2xl p-6 md:p-8">
              <h3 class="font-heading text-lg font-semibold" style="color: var(--color-text);">{z.title}</h3>
              <p class="mt-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">{z.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Warianty ramek -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="label-tag">{sections.warianty.eyebrow}</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            {sections.warianty.heading}
          </h2>
          <p class="mt-4 text-base font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={sections.warianty.text} />
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {frameVariants.map((v) => (
            <a href={`/oferta/${v.slug}/`} class="card-base rounded-2xl p-6 block group" style="text-decoration: none;">
              <div class="flex items-baseline gap-2">
                <span class="font-display text-4xl" style="color: var(--color-accent);">{v.size}</span>
                <span class="font-heading text-xs uppercase tracking-wider" style="color: var(--color-text-muted);">{v.unit}</span>
              </div>
              <h3 class="mt-3 font-heading text-base font-semibold" style="color: var(--color-text);">
                Fronty laminowane z&nbsp;ramką {v.size}&nbsp;{v.unit}
              </h3>
              <p class="mt-2 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">{v.tagline}</p>
              <div class="mt-4 inline-flex items-center gap-1.5 text-sm font-heading font-medium" style="color: var(--color-accent);">
                <span>{sections.warianty.ctaLabel}</span>
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Płyty i dekory -->
    <section class="section-padding py-12 md:py-20" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto">
        <span class="label-tag">{sections.plyty.eyebrow}</span>
        <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
          {sections.plyty.heading}
        </h2>
        <div class="mt-6 space-y-4 text-base leading-relaxed font-body" style="color: var(--color-text-secondary);">
          {sections.plyty.body.map((p) => (<p set:html={p} />))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-padding py-12 md:py-20">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <span class="label-tag">{sections.faq.eyebrow}</span>
          <h2 class="mt-6 font-display text-3xl sm:text-4xl tracking-tight" style="color: var(--color-text);">
            {sections.faq.heading}
          </h2>
        </div>
        <div class="space-y-4">
          {faq.map((f) => (
            <div class="card-base rounded-2xl p-6 md:p-8">
              <h3 class="font-heading text-base font-semibold" style="color: var(--color-text);">{f.title}</h3>
              <p class="mt-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section-padding py-16 md:py-24" style="background-color: var(--color-bg-secondary);">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);">
          {sections.cta.heading}
        </h2>
        <p class="mt-4 text-base md:text-lg font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={sections.cta.text} />
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={sections.cta.items[0].href} class="btn-primary">{sections.cta.items[0].label}</a>
          <a href={sections.cta.items[1].href} class="btn-secondary">{sections.cta.items[1].label}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
