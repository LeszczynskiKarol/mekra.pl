---
import content from '../content/pages/index.json';

const korzysci = content.sections.korzysci;
const porownanie = content.sections.porownanie;

// Ikony pozostają w kodzie — treść (title/text) edytowalna w index.json
const benefitIcons = [
  `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
  `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>`,
  `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" /></svg>`,
  `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25a2.25 2.25 0 01-2.25-2.25v-2.25z" /></svg>`,
  `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25c-1.5 3-6 6.75-6 11.25a6 6 0 0012 0c0-4.5-4.5-8.25-6-11.25z" /></svg>`,
];

const benefits = korzysci.items.map((item, i) => ({
  icon: benefitIcons[i],
  title: item.title,
  description: item.text,
}));

const comparison = porownanie.items;
---

<section id="korzysci" class="section-spacing section-padding relative">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto animate-on-scroll">
      <span class="label-tag">{korzysci.eyebrow}</span>
      <h2 class="mt-6 font-display text-3xl sm:text-4xl md:text-5xl tracking-tight" style="color: var(--color-text);" set:html={korzysci.heading} />
      <p class="mt-6 text-base md:text-lg leading-relaxed font-body" style="color: var(--color-text-secondary);" set:html={korzysci.text} />
    </div>

    <!-- Benefits grid -->
    <div class="mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {benefits.map((benefit, i) => (
        <div
          class="animate-on-scroll card-base rounded-2xl p-6 md:p-8"
          style={`transition-delay: ${i * 0.08}s;`}
        >
          <div
            class="w-12 h-12 rounded-xl flex items-center justify-center"
            style="background-color: var(--color-bg-tertiary); color: var(--color-accent);"
          >
            <Fragment set:html={benefit.icon} />
          </div>
          <h3 class="mt-5 font-heading text-lg font-semibold" style="color: var(--color-text);">
            {benefit.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed font-body" style="color: var(--color-text-secondary);">
            {benefit.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Material comparison -->
    <div class="mt-24 animate-on-scroll">
      <div class="text-center mb-12">
        <h3 class="font-display text-2xl sm:text-3xl tracking-tight" style="color: var(--color-text);">
          {porownanie.heading}
        </h3>
        <p class="mt-3 text-sm font-body" style="color: var(--color-text-secondary);">
          {porownanie.text}
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl" style="border: 1px solid var(--color-border);">
        <table class="w-full min-w-[640px]">
          <thead>
            <tr style="background-color: var(--color-bg-tertiary);">
              <th class="text-left py-4 px-6 font-heading text-sm font-semibold" style="color: var(--color-text);">{porownanie.bullets[0]}</th>
              <th class="text-center py-4 px-4 font-heading text-sm font-semibold" style="color: var(--color-text);">{porownanie.bullets[1]}</th>
              <th class="text-center py-4 px-4 font-heading text-sm font-semibold" style="color: var(--color-text);">{porownanie.bullets[2]}</th>
              <th class="text-center py-4 px-4 font-heading text-sm font-semibold" style="color: var(--color-text);">{porownanie.bullets[3]}</th>
              <th class="text-center py-4 px-4 font-heading text-sm font-semibold" style="color: var(--color-text);">{porownanie.bullets[4]}</th>
              <th class="text-center py-4 px-4 font-heading text-sm font-semibold" style="color: var(--color-text);">{porownanie.bullets[5]}</th>
              <th class="text-center py-4 px-4 font-heading text-sm font-semibold" style="color: var(--color-text);">{porownanie.bullets[6]}</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row, i) => (
              <tr
                class={`transition-colors duration-200 ${i === 0 ? '' : ''}`}
                style={`border-top: 1px solid var(--color-border); ${i === 0 ? 'background-color: var(--color-card-bg);' : ''}`}
              >
                <td class="py-4 px-6 font-heading text-sm font-medium" style={`color: ${i === 0 ? 'var(--color-accent)' : 'var(--color-text)'};`}>
                  {i === 0 && <span class="inline-block w-1.5 h-1.5 rounded-full mr-2" style="background-color: var(--color-accent);"></span>}
                  {row.name}
                </td>
                {[row.odpornosc, row.faktura, row.cena, row.kolory].map((val) => (
                  <td class="text-center py-4 px-4">
                    <div class="flex justify-center gap-0.5">
                      {Array.from({ length: 5 }, (_, j) => (
                        <div
                          class="w-2 h-2 rounded-full"
                          style={`background-color: ${j < val ? (i === 0 ? 'var(--color-accent)' : 'var(--color-text-muted)') : 'var(--color-border)'};`}
                        ></div>
                      ))}
                    </div>
                  </td>
                ))}
                <td class="text-center py-4 px-4">
                  {row.ramki ? (
                    <svg class="w-5 h-5 mx-auto" style={`color: ${i === 0 ? 'var(--color-accent)' : 'var(--color-text-muted)'};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  ) : (
                    <svg class="w-5 h-5 mx-auto" style="color: var(--color-text-muted); opacity: 0.3;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  )}
                </td>
                <td class="text-center py-4 px-4">
                  {row.ekologia ? (
                    <svg class="w-5 h-5 mx-auto" style={`color: ${i === 0 ? 'var(--color-accent)' : 'var(--color-text-muted)'};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  ) : (
                    <svg class="w-5 h-5 mx-auto" style="color: var(--color-text-muted); opacity: 0.3;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Material comparison notes -->
      <div class="mt-6 space-y-4">
        <div class="rounded-xl p-5" style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);">
          <p class="text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={porownanie.body[0]} />
        </div>
        <div class="rounded-xl p-5" style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);">
          <p class="text-sm font-body leading-relaxed" style="color: var(--color-text-secondary);" set:html={porownanie.body[1]} />
        </div>
        <p class="text-sm font-body text-center pt-2" style="color: var(--color-text-secondary);" set:html={porownanie.caption} />
      </div>
    </div>
  </div>
</section>