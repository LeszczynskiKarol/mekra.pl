---
// IKEA fronts section
import content from '../content/pages/index.json';

const ikea = content.sections.ikea;
---

<section class="section-spacing section-padding relative overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="animate-on-scroll card-base rounded-3xl overflow-hidden relative grid lg:grid-cols-2">
      <!-- Right: realizacja w stylu IKEA (front 36 mm, Grudziądz) -->
      <div class="ikea-photo lg:col-start-2 lg:row-start-1">
        <picture>
          <source srcset={ikea.image} type="image/webp" />
          <img
            src={ikea.image}
            alt={ikea.alt}
            width="1920"
            height="2880"
            loading="lazy"
            decoding="async"
            class="ikea-photo__img"
          />
        </picture>
      </div>

      <div class="relative p-8 md:p-12 lg:p-16 xl:p-20 lg:col-start-1 lg:row-start-1">
        <div class="max-w-2xl">
          <span class="label-tag">{ikea.eyebrow}</span>

          <h2 class="mt-6 font-display text-2xl sm:text-3xl md:text-4xl tracking-tight" style="color: var(--color-text);" set:html={ikea.heading} />

          <div class="mt-8 space-y-4 text-base leading-relaxed font-body" style="color: var(--color-text-secondary);">
            {ikea.body.map((p) => (<p set:html={p} />))}
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#kontakt" class="btn-primary">
              <span>{ikea.ctaLabel}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>

          <!-- Important note -->
          <div class="mt-8 flex gap-3 p-4 rounded-xl" style="background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border);">
            <svg class="w-5 h-5 flex-shrink-0 mt-0.5" style="color: var(--color-accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
            <p class="text-sm font-body" style="color: var(--color-text-secondary);" set:html={ikea.text} />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── IKEA section photo ─────────────────────────────────────────────────
     Replaces the decorative nested rectangles with a real realizacja. Sits in
     the right column on desktop (a top band on mobile) and feathers into the
     card on the text side via --color-card-bg, so it reads as one surface. */
  .ikea-photo {
    position: relative;
    min-height: 280px;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .ikea-photo { min-height: 100%; }
  }

  .ikea-photo__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
    filter: saturate(0.98);
  }
</style>
