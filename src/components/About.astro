---
// About section
import content from '../content/pages/index.json';

const oNas = content.sections.oNas;
---

<section id="o-nas" class="section-spacing section-padding relative overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      <!-- Text -->
      <div class="animate-on-scroll">
        <span class="label-tag">{oNas.eyebrow}</span>

        <h2 class="mt-6 font-display text-3xl sm:text-4xl md:text-5xl tracking-tight leading-tight" style="color: var(--color-text);" set:html={oNas.heading} />

        <div class="mt-8 space-y-5 text-base leading-relaxed font-body" style="color: var(--color-text-secondary);">
          {oNas.body.map((p) => (<p set:html={p} />))}
        </div>
      </div>

      <!-- Image placeholder -->
      <div class="animate-on-scroll" style="transition-delay: 0.2s;">
        <div class="relative">
          <div class="aspect-[4/5] rounded-2xl overflow-hidden card-base !shadow-none">
            <picture>
              <source
                type="image/webp"
                srcset="/img/mekra-produkcja-400.webp 400w, /img/mekra-produkcja-600.webp 600w, /img/mekra-produkcja-800.webp 800w, /img/mekra-produkcja-1000.webp 1000w"
                sizes="(min-width: 1024px) 500px, (min-width: 640px) 80vw, 90vw"
              />
              <img
                src={oNas.image}
                alt={oNas.alt}
                width="800"
                height="1000"
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-6 -left-6 md:-left-8 card-base rounded-2xl p-5 md:p-6">
            <div class="font-display text-2xl md:text-3xl" style="color: var(--color-accent);">{oNas.value}</div>
            <div class="text-sm font-body mt-1" style="color: var(--color-text-secondary);">{oNas.caption}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>